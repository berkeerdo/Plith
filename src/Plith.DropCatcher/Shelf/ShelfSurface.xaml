<UserControl x:Class="Plith.DropCatcher.Shelf.ShelfSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType">

    <!-- The shelf page, as a UserControl rather than a Window: a render harness can instantiate
         and photograph this, and it cannot do that with a layered Window. See CatcherWindow for
         the shape this stands beside: that one is the brief prompt shown mid-drag, this is the
         page a click into the resting shelf opens.

         No dictionary from Plith is merged here, deliberately. This project does not reference
         Plith.csproj (see Plith.DropCatcher.csproj's own comment on why: it must stay small and
         must not share Plith's startup), so pack://application:,,,/Plith;component/... would
         resolve only inside the render harness, which loads Plith.dll itself, and would fail
         silently the moment this runs as the real catcher process. The handful of icon shapes
         below are duplicated literal geometry rather than a shared resource for that reason, the
         same reason NotchGeometry.cs is LINKED rather than referenced: a real dependency on
         Plith's assembly is not available to pay for it.

         Every colour brush used below is resolved from THIS control's own Resources, filled in
         by Apply(ShelfPalette) at runtime, under the same keys Plith uses for the same things
         (OsdSurfaceBrush, NotchInk, NotchInkMuted, NotchTrack, AccentBrush). Nothing here reaches
         through Application.Resources: this process has no application-level theme, and the
         render harness proved once already (ShelfWidget) that anything reaching through
         Application renders in colours the product never shows. -->

    <!-- Only the BOTTOM corners are round, the same rule NotchGeometry.BottomRoundedClip states
         for the notch itself: this page grows out of the notch and is anchored at the same top
         screen edge (OpenShelf carries the same X/Y/W/H rectangle Show does), and rounding the
         top would carve two notches of desktop out of the edge the shape is part of. -->
    <Border x:Name="Surface"
            CornerRadius="0,0,16,16"
            Background="{DynamicResource OsdSurfaceBrush}"
            BorderThickness="1"
            BorderBrush="{DynamicResource NotchTrack}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: a title, and the one shelf-wide action left. Clear is a real Button
                 rather than a pressable Border, so Tab and a screen reader reach it the same way
                 any other control in the product is reached. The tiles below cannot be, because a
                 tile's action (select, then drag) has no equivalent gesture on a keyboard, which
                 is the same reason ShelfWidget's tiles are Borders and not Buttons. -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Shelf"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource NotchInk}" />

                <Button x:Name="ClearButton"
                        Grid.Column="1"
                        Width="28" Height="28"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        AutomationProperties.Name="Clear the shelf"
                        Click="OnClearClick">
                    <!-- Same coordinates as PlithIcons' IconClose, duplicated: see the header
                         comment. -->
                    <Path Data="M6,6 L18,18 M18,6 L6,18"
                          Width="14" Height="14"
                          Stretch="Uniform"
                          Stroke="{DynamicResource NotchInk}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <!-- The stacks, built in code the same way ShelfWidget builds its tiles: each one
                 needs its own AutomationProperties.Name and its own press handler, which an
                 ItemsControl template cannot give an individual generated element.

                 AllowDrop lives here, on the container, rather than on each built column: a
                 drop past the last stack has to land somewhere too (it means "start a new
                 stack"), and there is no column there to carry the flag. OnColumnsDrop works
                 out which column, if any, the drop point actually fell inside. -->
            <!-- The host is what catches the drop; Columns is what the eye sees.

                 They are two elements because they want opposite widths. Columns is centred, so
                 a shelf holding two stacks sits in the middle of the panel instead of hugging
                 the left edge with the rest of the card empty beside it. But the drop target has
                 to stay the FULL width: releasing a tile in the empty area past the last stack is
                 how a new stack is made, and a panel shrunk to its content would stop receiving
                 exactly the release that gesture needs.

                 So the handlers live out here and report positions in the host's coordinates.
                 TargetStackIndex translates each column into the same space, which is the only
                 reason it can still decide which column, if any, a point fell inside. -->
            <Grid x:Name="ColumnsHost"
                  Grid.Row="1"
                  VerticalAlignment="Top"
                  Background="Transparent"
                  AllowDrop="False">
                <StackPanel x:Name="Columns"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
