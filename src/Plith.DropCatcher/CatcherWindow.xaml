<Window x:Class="Plith.DropCatcher.CatcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowDrop="True"
        ResizeMode="NoResize"
        Width="356" Height="116"
        Left="-32000" Top="-32000"
        Title="Plith drop catcher">

    <!-- Layered, with per-pixel alpha, and that is a deliberate reversal.

         It was opaque so that a screenshot could see it, and that found two real defects. But the
         catcher stands in for the notch, and the notch morphs smoothly precisely BECAUSE it is
         layered: an opaque window cannot grow out of a 2 DIP strip, it can only appear. A hard
         cut between two processes is what a person reads as the shelf being broken, and it was
         the first thing reported about it.

         The cost is real, and stated here rather than rediscovered: this window cannot be
         captured over RDP by any means, so it can only be checked by looking at it. The
         background is 1% alpha rather than fully transparent because WPF hit-tests a Transparent
         brush but not a null one, and a window that takes no hit-test is a catcher that receives
         nothing at all. -->
    <Grid>
        <!-- ONE surface whose width, height and corner radius all come from a single expansion
             value, exactly as NotchGeometry drives the notch — the same file, linked into this
             project, so the stand-in cannot drift away from the shape it stands in for. Aligned
             to the top because the notch is part of the screen's top edge and grows down out
             of it. -->
        <Border x:Name="Shape"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="190" Height="6"
                Background="#F2141414"
                BorderThickness="1"
                BorderBrush="#33FFFFFF">
            <!-- Content fades in only after the shape has mostly settled, which is the whole
                 effect: the surface arrives first and the content arrives into it. -->
            <StackPanel x:Name="Body"
                        Opacity="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <!-- Drawn geometry rather than a glyph font: the same rule the rest of the
                     product follows. -->
                <Path HorizontalAlignment="Center"
                      Width="26" Height="26"
                      Stretch="Uniform"
                      Opacity="0.85"
                      Data="M 12,2 L 12,15 M 12,15 L 7,10 M 12,15 L 17,10 M 3,17 L 3,20 A 2,2 0 0 0 5,22 L 19,22 A 2,2 0 0 0 21,20 L 21,17"
                      Stroke="#FFFFFFFF" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <TextBlock x:Name="Caption"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#FFFFFFFF"
                           Opacity="0.85"
                           Text="Drop to keep on the shelf" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
