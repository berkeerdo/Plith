<UserControl x:Class="Plith.Views.Widgets.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:w="clr-namespace:Plith.Views.Widgets"
             mc:Ignorable="d"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Plith;component/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- This page carries its own ink, because it carries its own ground.

                 NotchInk is computed from the themed surface now - dark on the light theme, light
                 on the dark one - which is right for the pages that sit ON that surface. This one
                 does not: the artwork below is covered by a near-black scrim in both themes, so
                 the ground here is dark whatever the theme is. Inheriting the themed ink put dark
                 text on that scrim the moment the light theme was selected.

                 The weather page has the same shape for the same reason - it paints a sky, so it
                 sets its own colours too. A page that paints its own background owns its own
                 foreground. Declared after the merge above so it wins over anything merged. -->
            <SolidColorBrush x:Key="NotchInk" Color="#F2F5F8" />
            <SolidColorBrush x:Key="NotchInkMuted" Color="#9AA6B2" />

            <Style x:Key="TransportButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <!-- Dimmer than the title beside them, as the design has it: the controls are
                     available, not the thing you came to read. -->
                <Setter Property="Foreground" Value="{DynamicResource NotchInkMuted}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <!-- A resting ground, not just a hover one. The design gives each
                                 control a faint pill so the row reads as three controls rather
                                 than three floating marks; hover only brightens it. -->
                            <!-- TemplateBinding, not a literal: play/pause overrides this to sit
                                 a touch brighter than the two beside it, and a hard-coded value
                                 here would make that override do nothing at all. -->
                            <Border x:Name="Chrome" CornerRadius="15"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource OsdHighlight}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root" ClipToBounds="True">
        <!-- The artwork is the page, the way the sky is the weather page.

             A 46 DIP thumbnail beside two lines of text is a list row, and this is not a list -
             it is the one thing playing. Blown up, blurred and dropped behind a scrim, the album
             becomes the surface's colour, which is the same idea the weather page uses and makes
             the two read as one family rather than two unrelated screens.

             Blur is affordable HERE and was not on the clouds: this image changes when the track
             changes and is otherwise static, so the filter pass is paid once rather than every
             frame. -->
        <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False">
            <Image.Effect>
                <BlurEffect Radius="34" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
        </Image>

        <!-- Heavier on the left, where the text is, and thinning to the right so the artwork
             still shows through behind the transport. A flat scrim would hide the thing it is
             there to make readable. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.2">
                    <GradientStop Offset="0" Color="#E60A0D12" />
                    <GradientStop Offset="0.55" Color="#B00A0D12" />
                    <GradientStop Offset="1" Color="#7A0A0D12" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

    <!-- Art, then the text, then the transport on the right.

         The transport was briefly moved to a centred row underneath, on the argument that the
         right-hand rail left the title too little width. The rail won: it is where this control
         already sits on the Classic card and in every media surface a person already uses, and
         the width objection has its own answer one column to the left - the title scrolls
         instead of ellipsing. Keeping the rail also let the frame stay 116 tall rather than 128,
         which would have spent 12 DIP on all five pages to solve one page's problem. -->
    <Grid Margin="18,14,18,29" VerticalAlignment="Center">
        <!-- The art and the text are one target; the transport is not part of it. A page-wide
             click would swallow every press meant for a transport button on the same row. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="OpenSourceArea" Grid.Column="0" Grid.ColumnSpan="2"
                Background="Transparent" />

        <!-- Larger, and with a hairline over it. Album art is photographic and often dark at the
             edges, so without an inner edge it dissolves into the panel and reads as a smudge
             rather than as a picture with a boundary. -->
        <Border x:Name="ArtHost" Grid.Column="0" Width="46" Height="46" CornerRadius="8"
                Background="{DynamicResource NotchTrack}">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,46,46" RadiusX="8" RadiusY="8" />
            </Border.Clip>
            <Grid>
                <Image x:Name="Art" Stretch="UniformToFill" />
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#1FFFFFFF" />
            </Grid>
        </Border>

        <!-- MinWidth 0 is load-bearing: a star column sizes to its content's minimum by default,
             so a long title would push the transport off the frame instead of being clipped. -->
        <StackPanel x:Name="TextColumn" Grid.Column="1" MinWidth="0" Margin="12,0" VerticalAlignment="Center">
            <!-- TextElement.* rather than FontSize/Foreground directly: MarqueeText is a
                 FrameworkElement, which owns neither property. Both are inheritable, so setting
                 them here reaches the TextBlock inside exactly as it would anywhere else. -->
            <w:MarqueeText x:Name="Title"
                           Height="20"
                           FontSize="14.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource NotchInk}" />
            <w:MarqueeText x:Name="Artist"
                           Height="17"
                           Margin="0,2,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource NotchInkMuted}" />
        </StackPanel>

        <!-- Round, not rounded-square. Three circles read as a transport; three squares read as
             a toolbar, and this is the one row on the page a person reaches for without looking. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="Previous" Style="{StaticResource TransportButtonStyle}"
                    AutomationProperties.Name="Previous track">
                <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconPrevious}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas></Viewbox>
            </Button>
            <!-- The name is rewritten by Render() on every state change, because "Play" on a
                 button that pauses is worse than no name at all. The value here is the one it
                 carries before any session exists, and it is declared rather than left to code
                 so the accessibility lint can see it - a name that only ever exists at runtime
                 is a name nothing can check. -->
            <Button x:Name="PlayPause" Style="{StaticResource TransportButtonStyle}"
                    AutomationProperties.Name="Play"
                    Margin="4,0">
                <!-- Viewbox over a 24 Canvas, so every transport mark is scaled by the SAME
                     factor. Per-Path Stretch="Uniform" scaled each geometry's own bounds to the
                     box, which made play visibly larger than pause for no reason a person could
                     name — the geometries differ in extent, not in intended size. -->
                <Viewbox Width="14" Height="14">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="PlayPauseGlyph"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="Next" Style="{StaticResource TransportButtonStyle}"
                    AutomationProperties.Name="Next track">
                <Viewbox Width="14" Height="14"><Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconNext}"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Canvas></Viewbox>
            </Button>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
