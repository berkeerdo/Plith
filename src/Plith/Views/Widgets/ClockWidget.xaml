<UserControl x:Class="Plith.Views.Widgets.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:w="clr-namespace:Plith.Views.Widgets"
             mc:Ignorable="d"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Plith;component/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The "now" page: the time, and the two other things that are true right now.

         It was the time alone, centred in a frame that does not resize to it, and it read as an
         empty page with a clock on it - which is what "the clock widget is bad" meant. The frame
         is fixed, so that space is paid for whether or not anything uses it; a page that leaves
         it blank is not restrained, it is unfinished.

         What goes in it is chosen rather than found: the battery, which is a fact about now, and
         what is playing, which is the other one. Both collapse when they do not apply - no
         battery on a desktop, no track line with nothing playing - so on a machine where neither
         is true the page is the clock again, deliberately this time. -->
    <Grid Margin="18,12,18,27">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Time and date on one line, the date against the time's baseline rather than under
             it. Stacked, they took the height the track line now uses - and a date is a caption
             for the time, not a second reading. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="Time"
                       FontSize="36" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       LineHeight="36" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource NotchInk}" />
            <TextBlock x:Name="Date"
                       Margin="10,0,0,3"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="{DynamicResource NotchInkMuted}" />
            <Path x:Name="ChargingBolt"
                  Data="{StaticResource IconBolt}"
                  Fill="{DynamicResource NotchInkMuted}"
                  Width="10" Height="10" Stretch="Uniform"
                  Margin="10,0,3,4"
                  VerticalAlignment="Bottom"
                  Visibility="Collapsed" />
            <TextBlock x:Name="BatteryText"
                       Margin="0,0,0,3"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="{DynamicResource NotchInkMuted}"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- A hairline, and only when something is under it. A divider over nothing is a line
             that says "more below" and then does not deliver it. -->
        <Border x:Name="Rule" Grid.Row="1"
                Height="1" Margin="52,11,52,0"
                Background="#1AFFFFFF"
                Visibility="Collapsed" />

        <Grid x:Name="NowPlaying" Grid.Row="2" Margin="0,9,0,0"
              HorizontalAlignment="Center"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                    Background="{DynamicResource NotchTrack}">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4" />
                </Border.Clip>
                <Image x:Name="NowArt" Stretch="UniformToFill" />
            </Border>

            <!-- MaxWidth rather than a star column: the row is centred, and a star would stretch
                 it to the page and strand a short title's art at the left edge. The marquee needs
                 a bounded viewport either way - that is what it measures overflow against. -->
            <w:MarqueeText x:Name="NowTitle"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           MaxWidth="250"
                           Height="16"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource NotchInkMuted}" />
        </Grid>
    </Grid>
</UserControl>
