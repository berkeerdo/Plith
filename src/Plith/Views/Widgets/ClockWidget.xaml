<UserControl x:Class="Plith.Views.Widgets.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:w="clr-namespace:Plith.Views.Widgets"
             mc:Ignorable="d"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Plith;component/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The "now" page.

         Centred-stack was the wrong composition and it looked it. With the date and the battery
         hanging off the time's right, the block's optical centre sat left of the page's - so the
         one thing that WAS centred read as misaligned. Nothing here is centred now; it is set on
         a left edge with a second column against the right, which is a composition rather than
         an absence of one.

         Left is the time, which is why the page exists. Right is the weather, which is the other
         glanceable fact and was sitting on a page of its own that nobody opens to check whether
         it is raining. Along the bottom, what is playing. Each side collapses on its own: no
         weather without a reading, no track line with nothing playing, no battery on a desktop. -->
    <Grid Margin="20,14,20,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top">
            <TextBlock x:Name="Time"
                       FontSize="38" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       LineHeight="38" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource NotchInk}" />

            <StackPanel Orientation="Horizontal" Margin="1,3,0,0">
                <TextBlock x:Name="Date"
                           FontSize="12"
                           Foreground="{DynamicResource NotchInkMuted}" />
                <Path x:Name="ChargingBolt"
                      Data="{StaticResource IconBolt}"
                      Fill="{DynamicResource NotchInkMuted}"
                      Width="10" Height="10" Stretch="Uniform"
                      Margin="9,0,3,1"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
                <TextBlock x:Name="BatteryText"
                           FontSize="12"
                           Foreground="{DynamicResource NotchInkMuted}"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <!-- Right-aligned and baseline-matched to the time, so the two readings sit on one line
             rather than one floating beside the other. -->
        <StackPanel x:Name="WeatherBlock"
                    Grid.Row="0" Grid.Column="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed">
            <TextBlock x:Name="Temperature"
                       HorizontalAlignment="Right"
                       FontSize="26" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       LineHeight="38" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource NotchInk}" />
            <TextBlock x:Name="Condition"
                       HorizontalAlignment="Right"
                       Margin="0,3,1,0"
                       FontSize="12"
                       Foreground="{DynamicResource NotchInkMuted}" />
        </StackPanel>

        <Grid x:Name="NowPlaying" Grid.Row="1" Grid.ColumnSpan="2"
              VerticalAlignment="Bottom"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                    Background="{DynamicResource NotchTrack}">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4" />
                </Border.Clip>
                <Image x:Name="NowArt" Stretch="UniformToFill" />
            </Border>

            <w:MarqueeText x:Name="NowTitle"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Height="16"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource NotchInkMuted}" />
        </Grid>
    </Grid>
</UserControl>
