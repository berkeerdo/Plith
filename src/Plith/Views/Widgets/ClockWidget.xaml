<UserControl x:Class="Plith.Views.Widgets.ClockWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:w="clr-namespace:Plith.Views.Widgets"
             mc:Ignorable="d"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Plith;component/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The "now" page.

         Centred-stack was the wrong composition and it looked it. With the date and the battery
         hanging off the time's right, the block's optical centre sat left of the page's - so the
         one thing that WAS centred read as misaligned. Nothing here is centred now; it is set on
         a left edge with a second column against the right, which is a composition rather than
         an absence of one.

         Left is the time, which is why the page exists. Right is the weather, which is the other
         glanceable fact and was sitting on a page of its own that nobody opens to check whether
         it is raining. Along the bottom, what is playing. Each side collapses on its own: no
         weather without a reading, no track line with nothing playing, no battery on a desktop. -->
    <!-- Centred, not pinned to the top. The frame grew from 116 DIP to 164 on 2026-09-21 and
         this page kept its Auto rows at the top edge, which left about 60 DIP of dead space
         under the track line and made the page read as unfinished. The rows stay Auto: a star
         row here is a recorded defect, because it let the readings grow until the track line had
         nowhere to be. -->
    <Grid Margin="20,14,20,26" VerticalAlignment="Center">
        <!-- Auto over Auto with a gap between, not Auto over star. A star row let the readings
             grow until the track line underneath had nowhere left to be, and the two ran into
             each other. Two Auto rows cannot: each takes what it needs and the gap is real. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Time and date on ONE line, the date against the time's baseline.

             Stacked, this block came to 56 DIP; with the gap and the track line under it the
             page needed 86 and the frame has 76, so the track row ran off the bottom edge and
             was clipped in half. Putting the date beside the time gives back the 18 that
             overflowed - and it reads correctly here in a way it did not when everything was
             centred, because there is a left edge for both of them to sit on. -->
        <StackPanel Grid.Row="0" Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Top">
            <TextBlock x:Name="Time"
                       FontSize="36" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       LineHeight="36" LineStackingStrategy="BlockLineHeight"
                       Foreground="{DynamicResource NotchInk}" />
            <TextBlock x:Name="Date"
                       Margin="10,0,0,3"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="{DynamicResource NotchInkMuted}" />
            <Path x:Name="ChargingBolt"
                  Data="{StaticResource IconBolt}"
                  Fill="{DynamicResource NotchInkMuted}"
                  Width="10" Height="10" Stretch="Uniform"
                  Margin="9,0,3,4"
                  VerticalAlignment="Bottom"
                  Visibility="Collapsed" />
            <TextBlock x:Name="BatteryText"
                       Margin="0,0,0,3"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="{DynamicResource NotchInkMuted}"
                       Visibility="Collapsed" />

            <!-- The microphone, and ONLY when it is muted.
                 An indicator that is present whether or not anything is wrong is a thing people
                 stop seeing, and "my mic is on" is the state you are in for almost every minute
                 of every day. Muted is the exception worth a mark - and the one people discover
                 thirty seconds into talking to nobody. -->
            <Viewbox x:Name="MicMark" Width="14" Height="14"
                     Margin="12,0,0,4"
                     VerticalAlignment="Bottom"
                     Visibility="Collapsed">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconMic}" Fill="{DynamicResource NotchInkMuted}" />
                    <Path Data="{StaticResource IconMicStand}"
                          Stroke="{DynamicResource NotchInkMuted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="{StaticResource IconMicCross}"
                          Stroke="{DynamicResource NotchInkMuted}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Viewbox>
        </StackPanel>

        <!-- Right-aligned and baseline-matched to the time, so the two readings sit on one line
             rather than one floating beside the other. -->
        <StackPanel x:Name="WeatherBlock"
                    Grid.Row="0" Grid.Column="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Visibility="Collapsed">
            <!-- The mark, then the number. A word said this before - "Partly cloudy" under a
                 temperature - and a word is the slowest way to say something a shape says before
                 it is read, on a surface looked at for two seconds. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <w:WeatherMark x:Name="Mark"
                               Width="26" Height="26"
                               Margin="0,0,9,0"
                               VerticalAlignment="Center"
                               Ink="{DynamicResource NotchInk}" />
                <TextBlock x:Name="Temperature"
                           FontSize="28" FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"
                           LineHeight="36" LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource NotchInk}" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="NowPlaying" Grid.Row="1" Grid.ColumnSpan="2"
              Margin="0,14,0,0"
              VerticalAlignment="Bottom"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                    Background="{DynamicResource NotchTrack}">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,18,18" RadiusX="4" RadiusY="4" />
                </Border.Clip>
                <Image x:Name="NowArt" Stretch="UniformToFill" />
            </Border>

            <w:MarqueeText x:Name="NowTitle"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Height="16"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource NotchInkMuted}" />
        </Grid>
    </Grid>
</UserControl>
