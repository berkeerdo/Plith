<UserControl x:Class="Plith.Views.Widgets.WeatherMark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             IsHitTestVisible="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Plith;component/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- A weather mark that moves.

         The word was doing this job - "Overcast" under a temperature - and a word is the slowest
         way to say something a shape says instantly. Composed from parts rather than drawn per
         condition: a sun behind a cloud is the sun AND the cloud, so there is no third drawing to
         keep in step with the other two when one of them changes.

         Every part shares one Canvas on the 24 grid, scaled once by the Viewbox. Drawn any other
         way, each piece scales to its own extent and they stop lining up - which is exactly what
         went wrong with the speaker. -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="24" Height="24">
            <Path x:Name="Rays" Data="{StaticResource IconWxRays}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Visibility="Collapsed">
                <Path.RenderTransform>
                    <RotateTransform x:Name="RaySpin" CenterX="12" CenterY="12" />
                </Path.RenderTransform>
            </Path>

            <Path x:Name="Sun" Data="{StaticResource IconWxSun}" Visibility="Collapsed">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="SunPulse" CenterX="12" CenterY="12" />
                </Path.RenderTransform>
            </Path>

            <Path x:Name="Moon" Data="{StaticResource IconWxMoon}" Visibility="Collapsed" />

            <Path x:Name="Cloud" Data="{StaticResource IconWxCloud}" Visibility="Collapsed">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="CloudDrift" />
                </Path.RenderTransform>
            </Path>

            <Path x:Name="Fall" Visibility="Collapsed">
                <Path.RenderTransform>
                    <TranslateTransform x:Name="FallDrop" />
                </Path.RenderTransform>
            </Path>
        </Canvas>
    </Viewbox>
</UserControl>
