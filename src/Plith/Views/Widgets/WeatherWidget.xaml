<UserControl x:Class="Plith.Views.Widgets.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False">
    <!-- The sky is not an icon on this page. The sky IS the page.
         On a surface this small a 60 DIP glyph beside a number spends most of the frame on a
         decoration, and Samsung's weather app is the reference for the alternative: the whole
         background becomes the weather.

         Everything here bleeds past the page's own bounds on purpose - the frame's page host
         clips it, so the gradient reaches the panel's edges rather than sitting inside the
         padding the other pages use. -->
    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.RenderTransform>
            <!-- Grown slightly and offset, so the sky covers the page row's padding on every
                 side. Without this the gradient would stop short of the panel edge and read as
                 a card with a picture on it. -->
            <!-- Centre is written from code on every size change, not fixed here. The literals
                 it replaced were half of numbers that are not this element's: the page row is
                 the frame minus its padding and the dots lane, so a hard-coded centre was
                 already slightly off and would have gone further off the moment the frame
                 changed size. -->
            <ScaleTransform x:Name="Bleed" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Rectangle x:Name="Sky" />

        <!-- The sun blooms rather than spins. At this size a rotating ray wheel reads as a
             loading spinner, which is the one thing a weather page must not look like. It sits
             off-centre and partly out of frame, which is what makes the sky feel larger than the
             panel it is drawn in. -->
        <Ellipse x:Name="Bloom" Width="120" Height="120"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-46,-28,0"
                 Visibility="Collapsed">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FFFFF3C4" />
                    <GradientStop Offset="0.45" Color="#66FFE9A8" />
                    <GradientStop Offset="1" Color="#00FFE9A8" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="BloomPulse" ScaleX="1" ScaleY="1" CenterX="60" CenterY="60" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="Moon" Width="26" Height="26"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,14,34,0"
                 Fill="#FFE8EEF6" Opacity="0.85"
                 Visibility="Collapsed" />

        <!-- Clouds and precipitation are generated in code: their count and stagger depend on
             the sky, and a fixed set in XAML would either be too many for a clear sky or too few
             for an overcast one. -->
        <Canvas x:Name="Clouds" IsHitTestVisible="False" />
        <Canvas x:Name="Fall" IsHitTestVisible="False" />

        <!-- A scrim under the text. Without it the temperature disappears into a rain gradient,
             which is exactly where it is most worth reading. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                    <GradientStop Offset="0" Color="#9E06080C" />
                    <GradientStop Offset="0.46" Color="#5706080C" />
                    <GradientStop Offset="1" Color="#0D06080C" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel x:Name="Readout" VerticalAlignment="Center" Margin="18,0">
            <TextBlock x:Name="Temperature"
                       FontSize="34" FontWeight="SemiBold"
                       LineHeight="36" LineStackingStrategy="BlockLineHeight"
                       Foreground="White" />
            <TextBlock x:Name="Condition"
                       Margin="0,3,0,0"
                       FontSize="12.5"
                       Foreground="#E6FFFFFF" />
            <TextBlock x:Name="Detail"
                       Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="#AEFFFFFF" />
        </StackPanel>
    </Grid>
</UserControl>
