<UserControl x:Class="Plith.Views.Widgets.WeatherWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False">
    <!-- The sky is not an icon on this page. The sky IS the page.
         On a surface this small a 60 DIP glyph beside a number spends most of the frame on a
         decoration, and Samsung's weather app is the reference for the alternative: the whole
         background becomes the weather.

         Everything here bleeds past the page's own bounds on purpose - the frame's page host
         clips it, so the gradient reaches the panel's edges rather than sitting inside the
         padding the other pages use. -->
    <Grid x:Name="Root" ClipToBounds="True">
        <!-- The sky is its own layer, and the bleed scales ONLY that layer.
             It used to sit on this Grid, which scaled the readout and the moon along with the
             gradient: the temperature grew until it clipped at the top, the update line clipped
             at the bottom, and a 26 DIP moon came out half again as large. The mockup keeps them
             apart for exactly this reason - the sky overflows the frame, the text never does. -->
        <!-- The bleed is a negative margin, not a scale.
             A scale of 1.11 across and 1.34 down is not a bleed, it is a squash: it stretched
             everything in this layer, and a 26 DIP moon came out a visible oval. A margin
             extends the layer past the frame without touching what is drawn in it. The transform
             below stays at 1 and exists only for the day's arrival, which scales uniformly. -->
        <Grid x:Name="SkyLayer" Margin="-24">
        <Grid.RenderTransform>
            <!-- Grown slightly and offset, so the sky covers the page row's padding on every
                 side. Without this the gradient would stop short of the panel edge and read as
                 a card with a picture on it. -->
            <!-- Centre is written from code on every size change, not fixed here. The literals
                 it replaced were half of numbers that are not this element's: the page row is
                 the frame minus its padding and the dots lane, so a hard-coded centre was
                 already slightly off and would have gone further off the moment the frame
                 changed size. -->
            <ScaleTransform x:Name="Bleed" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <Rectangle x:Name="Sky" />

        <!-- The sun blooms rather than spins. At this size a rotating ray wheel reads as a
             loading spinner, which is the one thing a weather page must not look like. It sits
             off-centre and partly out of frame, which is what makes the sky feel larger than the
             panel it is drawn in. -->
        <Ellipse x:Name="Bloom" Width="120" Height="120"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-22,-4,0"
                 Visibility="Collapsed">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Offset="0" Color="#FFFFF3C4" />
                    <GradientStop Offset="0.45" Color="#66FFE9A8" />
                    <GradientStop Offset="1" Color="#00FFE9A8" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="BloomPulse" ScaleX="1" ScaleY="1" CenterX="60" CenterY="60" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Offsets carry the sky layer's own -24 bleed: an element aligned to this layer's top
             right sits 24 outside the frame, so the design's 14/34 becomes 38/58 here. Without
             that the moon hung half off the top corner. -->
        <Ellipse x:Name="Moon" Width="26" Height="26"
                 HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,38,58,0"
                 Fill="#FFE8EEF6" Opacity="0.85"
                 Visibility="Collapsed" />

        <!-- Clouds and precipitation are generated in code: their count and stagger depend on
             the sky, and a fixed set in XAML would either be too many for a clear sky or too few
             for an overcast one. -->
        <Canvas x:Name="Clouds" IsHitTestVisible="False" />
        <Canvas x:Name="Fall" IsHitTestVisible="False" />

        </Grid>

        <!-- A scrim under the text. Without it the temperature disappears into a rain gradient,
             which is exactly where it is most worth reading. Outside the sky layer, so it covers
             the frame rather than the scaled-up sky. -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.35">
                    <GradientStop Offset="0" Color="#9E06080C" />
                    <GradientStop Offset="0.46" Color="#5706080C" />
                    <GradientStop Offset="1" Color="#0D06080C" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Inset on the sides only. The page is vertically centred and the sky behind it wants
             every pixel, so vertical padding here bought nothing and cost the readout the room
             it needed - the temperature clipped at the top and the update line at the bottom. -->
        <StackPanel x:Name="Readout" VerticalAlignment="Center" Margin="18,0,18,14">
            <TextBlock x:Name="Temperature"
                       FontSize="30" FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       LineHeight="31" LineStackingStrategy="BlockLineHeight"
                       Foreground="White">
                <!-- The design puts a soft shadow under the number for the same reason the scrim
                     is there: over a bright sky, white on pale blue is the one thing on the page
                     that stops being readable. -->
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="12"
                                      Opacity="0.45" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="Condition"
                       Margin="0,3,0,0"
                       FontSize="12.5"
                       Foreground="#E6FFFFFF" />
            <TextBlock x:Name="Detail"
                       Margin="0,5,0,0"
                       FontSize="11"
                       Foreground="#AEFFFFFF" />
        </StackPanel>
    </Grid>
</UserControl>
