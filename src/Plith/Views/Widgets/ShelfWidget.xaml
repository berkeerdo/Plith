<UserControl x:Class="Plith.Views.Widgets.ShelfWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Plith;component/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- What is on the shelf.

         A row of tiles rather than a list of lines, because the shelf answers "what did I put
         here" at a glance, and a name is a slower way to recognise your own file than its shape
         and position.

         No heading. The first pass had one, with a "+3 more" label in the opposite corner, and
         rendering it showed why neither survives: the heading cost 25 of the 76 DIP the page
         has, which clipped every tile label through the middle. The page dots already say which
         page this is, and no other page in the frame introduces itself. What the row cannot show
         is now the last tile instead - a count in a corner is something to read, a tile is
         something that looks like the rest of the row and is understood without being read.

         A Grid now rather than the row alone, because the row gained a line under it. The row's
         track is star-sized and the line's is Auto, so the line cannot be pushed off the page by
         a row that measures taller than it was meant to: the row clips inside its own track
         instead, which is the same rule WidgetFrame applies to the page as a whole.

         The bottom margin is 22, not 24, and the row is 70 tall rather than 76. Those four DIP
         plus the six are what the line under the row is made of. It has to end above y=96, where
         WidgetFrame's rail lane begins - the rail is invisible most of the time and fades in on
         every page turn, so anything overlapping it is a collision that only appears while the
         page is being changed. -->
    <Grid Margin="20,12,20,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Tiles"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Top" />

        <!-- The one place the product says the shelf opens.

             Set in XAML rather than built in Render, because it is the same sentence whatever
             the row above it holds, and a line rebuilt on every shelf change is a line that can
             be rebuilt wrongly. Render only chooses whether it is showing and, when the shelf
             cannot open, replaces the text with the reason. -->
        <TextBlock x:Name="Hint"
                   Grid.Row="1"
                   Text="Click to open the shelf"
                   FontSize="10"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource NotchInkMuted}"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
