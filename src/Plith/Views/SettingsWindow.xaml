<Window x:Class="Plith.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Plith.Services"
        xmlns:views="clr-namespace:Plith.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Plith Settings"
        Width="900" Height="700" MinWidth="780" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ObjectDataProvider x:Key="OsdPositions" MethodName="GetValues" ObjectType="{x:Type svc:OsdPosition}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="svc:OsdPosition" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="AudioSources" MethodName="GetValues" ObjectType="{x:Type svc:AudioSourceMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="svc:AudioSourceMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <ObjectDataProvider x:Key="ThemeModes" MethodName="GetValues" ObjectType="{x:Type svc:ThemeMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="svc:ThemeMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom titlebar — drag region with accent dot, title, and caption buttons -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Border Width="6" Height="6"
                            CornerRadius="3"
                            Background="{DynamicResource Accent}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />
                    <TextBlock Text="Plith"
                               FontFamily="{StaticResource UiFont}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·"
                               Foreground="{DynamicResource TextTertiary}"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Settings"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                            AutomationProperties.Name="Minimize" />
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE922;"
                            ToolTip="Maximize"
                            AutomationProperties.Name="Maximize" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            AutomationProperties.Name="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header text + subtitle -->
        <Border Grid.Row="1"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1"
                Padding="32,12,32,22">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleStyle}" Text="Settings" />
                <TextBlock Style="{StaticResource SubtitleStyle}"
                           Margin="0,4,0,0"
                           Text="Tune how Plith surfaces audio and media changes on this PC." />
            </StackPanel>
        </Border>

        <!-- Split content: settings list on the left, live preview on the right -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="320" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource CardBorder}"
                    Margin="0,16,0,16" />

            <!-- Named because WPF makes ScrollViewer keyboard-focusable by default, so it is a
                 real tab stop: it was reached fourth, right after the caption buttons, and
                 announced as nothing but "pane". Naming it rather than setting
                 Focusable="False" keeps the affordance a keyboard user has for scrolling this
                 long page without tabbing through every control in it. -->
            <ScrollViewer Grid.Column="0"
                          AutomationProperties.Name="Settings"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="32,24,24,24">
                <StackPanel HorizontalAlignment="Stretch">

                <!-- ============== Appearance ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Appearance" Margin="4,0,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="ThemeLabel" Style="{StaticResource RowLabelStyle}" Text="Theme" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Dark and Light affect this Settings window. Auto follows your Windows app theme live. The OSD overlay stays dark in every mode for readability over games." />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo"
                                          Grid.Column="1"
                                          Style="{StaticResource ModernComboStyle}"
                                          ItemsSource="{Binding Source={StaticResource ThemeModes}}"
                                          VerticalAlignment="Center"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" />
                            </Grid>
                        </Border>

                        <!-- Theme Studio: 8 preset accent swatches + a Custom slot that opens
                             an HSL picker popup. Swatches are built in code-behind so click,
                             selection ring, and preview-tick states can be driven from one
                             list rather than N x N XAML permutations. -->
                        <Border Style="{StaticResource RowLastStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Accent color" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="Tints buttons, sliders, and the OSD volume bar. Backgrounds stay palette-driven so contrast never breaks." />
                                <WrapPanel x:Name="AccentSwatchPanel"
                                           Orientation="Horizontal"
                                           Margin="0,14,0,0" />
                                <Popup x:Name="CustomAccentPopup"
                                       PlacementTarget="{Binding ElementName=AccentSwatchPanel}"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       HorizontalOffset="0"
                                       VerticalOffset="6">
                                    <Border Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource CardBorderStrong}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="18"
                                            SnapsToDevicePixels="True">
                                        <StackPanel Width="264">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabelStyle}" Text="Custom accent" />
                                                <Border x:Name="CustomPreviewSwatch"
                                                        Grid.Column="1"
                                                        Width="24" Height="24"
                                                        CornerRadius="12"
                                                        Background="{DynamicResource Accent}"
                                                        BorderBrush="{DynamicResource CardBorderStrong}"
                                                        BorderThickness="1" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource RowHintStyle}" Text="Drag the sliders or paste a hex code." />

                                            <!-- Hue -->
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="H" Style="{StaticResource RowHintStyle}" Margin="0" VerticalAlignment="Center" />
                                                <Slider x:Name="CustomHueSlider"
                                                        Grid.Column="1"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0" Maximum="360"
                                                        Margin="8,0,8,0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Hue"
                                                        AutomationProperties.HelpText="Value from 0 to 360 degrees." />
                                                <TextBlock x:Name="CustomHueValue" Grid.Column="2" Style="{StaticResource RowHintStyle}" Margin="0" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <!-- Saturation -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="S" Style="{StaticResource RowHintStyle}" Margin="0" VerticalAlignment="Center" />
                                                <Slider x:Name="CustomSatSlider"
                                                        Grid.Column="1"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0" Maximum="100"
                                                        Margin="8,0,8,0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Saturation"
                                                        AutomationProperties.HelpText="Value from 0 to 100 percent." />
                                                <TextBlock x:Name="CustomSatValue" Grid.Column="2" Style="{StaticResource RowHintStyle}" Margin="0" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                            <!-- Luminance -->
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" MinWidth="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="L" Style="{StaticResource RowHintStyle}" Margin="0" VerticalAlignment="Center" />
                                                <Slider x:Name="CustomLumSlider"
                                                        Grid.Column="1"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        Minimum="0" Maximum="100"
                                                        Margin="8,0,8,0"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="Lightness"
                                                        AutomationProperties.HelpText="Value from 0 to 100 percent." />
                                                <TextBlock x:Name="CustomLumValue" Grid.Column="2" Style="{StaticResource RowHintStyle}" Margin="0" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Hex box -->
                                            <TextBox x:Name="CustomHexBox"
                                                     Margin="0,14,0,0"
                                                     Padding="10,7"
                                                     Background="{DynamicResource ButtonGhost}"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     CaretBrush="{DynamicResource TextPrimary}"
                                                     BorderBrush="{DynamicResource CardBorderStrong}"
                                                     BorderThickness="1"
                                                     FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                                     FontSize="12"
                                                     MaxLength="9"
                                                     AutomationProperties.Name="Accent color hex value" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ============== OSD ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="On-screen display" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="72" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="ShowDurationLabel" Style="{StaticResource RowLabelStyle}" Text="Show duration" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="How long the OSD stays visible after the last change." />
                                    <Slider x:Name="DurationSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Margin="0,14,0,0"
                                            Minimum="500" Maximum="10000"
                                            Value="2000"
                                            AutomationProperties.LabeledBy="{Binding ElementName=ShowDurationLabel}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ValueTagStyle}"
                                           VerticalAlignment="Top"
                                           TextAlignment="Right">
                                    <Run Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat={}{0:0}}" />
                                    <Run Text=" ms" Foreground="{DynamicResource TextSecondary}" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="Position" />
                                    <TextBlock x:Name="PositionSummary"
                                               Style="{StaticResource RowHintStyle}"
                                               Text="Click 'Set position' to place the OSD anywhere on any monitor. A dim overlay with nine snap hotspots opens over your desktop." />
                                </StackPanel>
                                <Button x:Name="OpenPositionOverlayButton"
                                        Grid.Column="1"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="Set position"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Set position" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="HoverKeepAliveLabel" Style="{StaticResource RowLabelStyle}" Text="Hover keep-alive" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Pause the auto-hide timer while the mouse is over the OSD." />
                                </StackPanel>
                                <CheckBox x:Name="HoverToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=HoverKeepAliveLabel}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="68" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="OpacityLabel" Style="{StaticResource RowLabelStyle}" Text="Opacity" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="OSD card opacity at rest. 50 % is the minimum readable level." />
                                    <Slider x:Name="OpacitySlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Margin="0,14,0,0"
                                            Minimum="50" Maximum="100"
                                            Value="100"
                                            AutomationProperties.LabeledBy="{Binding ElementName=OpacityLabel}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ValueTagStyle}"
                                           VerticalAlignment="Top"
                                           TextAlignment="Right">
                                    <Run Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:0}}" />
                                    <Run Text=" %" Foreground="{DynamicResource TextSecondary}" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="ColorThresholdsLabel" Style="{StaticResource RowLabelStyle}" Text="Color thresholds" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Volume bar turns amber near the top, red into the loud zone. Off keeps a calm constant green." />
                                </StackPanel>
                                <CheckBox x:Name="ColorThresholdsToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=ColorThresholdsLabel}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="CompactModeLabel" Style="{StaticResource RowLabelStyle}" Text="Compact mode" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Hide the media card so the OSD only shows the volume bar." />
                                </StackPanel>
                                <CheckBox x:Name="CompactToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=CompactModeLabel}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="FullscreenVideoLabel" Style="{StaticResource RowLabelStyle}" Text="Hide during fullscreen video" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Hides the OSD while a fullscreen window is playing video. Games are never affected." />
                                </StackPanel>
                                <CheckBox x:Name="FullscreenVideoToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=FullscreenVideoLabel}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <StackPanel>
                                <TextBlock x:Name="FullscreenHideListLabel" Style="{StaticResource RowLabelStyle}" Text="Also hide in these apps" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="Comma-separated process names, for players that don't report media to Windows." />
                                <TextBox x:Name="FullscreenHideListBox"
                                         Margin="0,14,0,0"
                                         Padding="10,7"
                                         Background="{DynamicResource ButtonGhost}"
                                         Foreground="{DynamicResource TextPrimary}"
                                         CaretBrush="{DynamicResource TextPrimary}"
                                         BorderBrush="{DynamicResource CardBorderStrong}"
                                         BorderThickness="1"
                                         FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                         FontSize="12"
                                         AutomationProperties.LabeledBy="{Binding ElementName=FullscreenHideListLabel}"
                                         AutomationProperties.HelpText="Comma-separated process executable names, e.g. mpv.exe, vlc.exe." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource RowLastStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="SummonHotkeyLabel" Style="{StaticResource RowLabelStyle}" Text="Summon hotkey" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="System-wide shortcut that pops the OSD with the current values. Choose a combo your other apps don't use." />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button x:Name="HotkeyCaptureButton"
                                            Style="{StaticResource HotkeyCaptureButtonStyle}"
                                            Content="Not set"
                                            AutomationProperties.LabeledBy="{Binding ElementName=SummonHotkeyLabel}" />
                                    <Button x:Name="HotkeyClearButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Clear"
                                            FontSize="11"
                                            MinHeight="34"
                                            MinWidth="60"
                                            Padding="10,0"
                                            Margin="6,0,0,0"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Clear hotkey" />
                                </StackPanel>
                                <TextBlock x:Name="HotkeyConflictWarning"
                                           Grid.Row="1" Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource ErrorText}"
                                           FontSize="11"
                                           FontWeight="Medium"
                                           Visibility="Collapsed"
                                           Text="Already taken by another app — pick a different combo." />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ============== Audio ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Audio source" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <Border x:Name="AudioSourceRow" Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="AudioSourceLabel" Style="{StaticResource RowLabelStyle}" Text="Audio source" />
                                    <TextBlock x:Name="AudioSourceHint"
                                               Style="{StaticResource RowHintStyle}"
                                               Text="Auto prefers Voicemeeter when it's running and falls back to the Windows default endpoint." />
                                </StackPanel>
                                <ComboBox x:Name="SourceCombo"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboStyle}"
                                          ItemsSource="{Binding Source={StaticResource AudioSources}}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=AudioSourceLabel}" />
                            </Grid>
                        </Border>

                        <Border x:Name="WindowsEndpointRow" Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="WindowsEndpointLabel" Style="{StaticResource RowLabelStyle}" Text="Windows endpoint" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Which render device the OSD tracks. Default follows Windows; pick a Sonar channel to lock onto it." />
                                </StackPanel>
                                <ComboBox x:Name="EndpointCombo"
                                          Grid.Column="1"
                                          MaxWidth="260"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=WindowsEndpointLabel}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FriendlyName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border x:Name="MonitoredBusRow" Style="{StaticResource RowLastStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock x:Name="MonitoredBusLabel" Style="{StaticResource RowLabelStyle}" Text="Monitored Voicemeeter bus" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Which bus drives the OSD when Voicemeeter is the active source. A1 is the default route the volume keys land on." />
                                </StackPanel>
                                <ComboBox x:Name="BusCombo"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboStyle}"
                                          AutomationProperties.LabeledBy="{Binding ElementName=MonitoredBusLabel}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ============== Media ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Media" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <Border Style="{StaticResource RowLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock x:Name="ShowOnTrackChangeLabel" Style="{StaticResource RowLabelStyle}" Text="Show on track change" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="Off by default. When on, the OSD pops every time the current player advances or toggles play/pause." />
                            </StackPanel>
                            <CheckBox x:Name="AutoShowMediaToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=ShowOnTrackChangeLabel}" />
                        </Grid>
                    </Border>
                </Border>

                <!-- ============== General ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="General" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <Border Style="{StaticResource RowLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock x:Name="LaunchAtLoginLabel" Style="{StaticResource RowLabelStyle}" Text="Launch at Windows login" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="Adds a per-user registry entry so Plith starts automatically." />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      AutomationProperties.LabeledBy="{Binding ElementName=LaunchAtLoginLabel}" />
                        </Grid>
                    </Border>
                </Border>

                <!-- ============== Game mode ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Game mode" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <Border Style="{StaticResource RowLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="GameModeDot"
                                    Grid.Column="0"
                                    Width="8" Height="8"
                                    CornerRadius="4"
                                    VerticalAlignment="Top"
                                    Margin="0,6,12,0"
                                    Background="{DynamicResource WarningAmber}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="GameModeStatusLabel"
                                           Style="{StaticResource RowLabelStyle}"
                                           Text="Game mode: Limited" />
                                <TextBlock x:Name="GameModeHint"
                                           Style="{StaticResource RowHintStyle}"
                                           Text="Run scripts\install-local.ps1 (admin) to install Plith with UIAccess and draw over exclusive fullscreen games." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- ============== Updates ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Updates" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <Border Style="{StaticResource RowLastStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock x:Name="UpdateStatusLabel"
                                               Style="{StaticResource RowLabelStyle}"
                                               Text="Version — press Check for updates" />
                                    <TextBlock x:Name="UpdateStatusHint"
                                               Style="{StaticResource RowHintStyle}"
                                               Text="Downloads from GitHub releases and runs the installer." />
                                </StackPanel>
                                <Button x:Name="UpdateCheckButton"
                                        Grid.Column="1"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Content="Check for updates"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Check for updates" />
                            </Grid>
                            <!-- Progress + actions surface only after "Check for updates" resolves.
                                 Layout: progress bar spans full width up top (readable at any card
                                 width) with the action buttons wrapping right-aligned underneath so
                                 the narrow-column case doesn't clip the "Download and install" CTA. -->
                            <StackPanel x:Name="UpdateActionRow" Margin="0,14,0,0" Visibility="Collapsed">
                                <ProgressBar x:Name="UpdateProgressBar"
                                             Style="{StaticResource ModernProgressBarStyle}"
                                             Minimum="0" Maximum="1"
                                             Visibility="Collapsed" />
                                <WrapPanel Orientation="Horizontal"
                                           HorizontalAlignment="Right"
                                           Margin="0,12,0,0">
                                    <Button x:Name="UpdateOpenPageButton"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Content="Release notes"
                                            Margin="0,0,8,4"
                                            AutomationProperties.Name="Release notes" />
                                    <Button x:Name="UpdateDownloadButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Download and install"
                                            Margin="0,0,0,4"
                                            AutomationProperties.Name="Download and install" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                </StackPanel>
            </ScrollViewer>

            <views:SettingsPreview x:Name="Preview"
                                    Grid.Column="2"
                                    Margin="24,24,32,24" />
        </Grid>

        <!-- Sticky footer: auto-save indicator + Esc hint. No Save / Cancel buttons —
             every change persists immediately. -->
        <Border Grid.Row="3"
                Background="{DynamicResource HeaderBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Saved indicator: a tiny accent dot + label, opacity pulses on change. -->
                <StackPanel x:Name="SavedIndicator"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Opacity="0.55">
                    <Border Width="6" Height="6"
                            CornerRadius="3"
                            Background="{DynamicResource Accent}"
                            VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource RowHintStyle}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="All settings saved" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource KbdHintStyle}">
                        <TextBlock Style="{StaticResource KbdHintTextStyle}" Text="Esc" />
                    </Border>
                    <TextBlock Style="{StaticResource RowHintStyle}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="close" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
