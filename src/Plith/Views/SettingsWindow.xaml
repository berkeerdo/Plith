<Window x:Class="Plith.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Plith.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Plith Settings"
        Width="560" Height="680" MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"
                            CornerRadius="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ObjectDataProvider x:Key="OsdPositions" MethodName="GetValues" ObjectType="{x:Type svc:OsdPosition}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="svc:OsdPosition" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom titlebar — drag region with accent dot, title, and caption buttons -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBg}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <Border Width="6" Height="6"
                            CornerRadius="3"
                            Background="{StaticResource Accent}"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0" />
                    <TextBlock Text="Plith"
                               FontFamily="{StaticResource UiFont}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="·"
                               Foreground="{StaticResource TextTertiary}"
                               Margin="8,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Settings"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeButton"
                            Style="{StaticResource CaptionButtonStyle}"
                            Content="&#xE921;"
                            ToolTip="Minimize" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource CloseCaptionButtonStyle}"
                            Content="&#xE8BB;"
                            ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Header text + subtitle -->
        <Border Grid.Row="1"
                Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,0,1"
                Padding="32,12,32,22">
            <StackPanel>
                <TextBlock Style="{StaticResource TitleStyle}" Text="Settings" />
                <TextBlock Style="{StaticResource SubtitleStyle}"
                           Margin="0,4,0,0"
                           Text="Tune how Plith surfaces audio and media changes on this PC." />
            </StackPanel>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="32,24">
            <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">

                <!-- ============== OSD ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="On-screen display" Margin="4,0,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" MinWidth="72" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="Show duration" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="How long the OSD stays visible after the last change." />
                                    <Slider x:Name="DurationSlider"
                                            Style="{StaticResource ModernSliderStyle}"
                                            Margin="0,14,0,0"
                                            Minimum="500" Maximum="10000"
                                            Value="2000" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource ValueTagStyle}"
                                           VerticalAlignment="Top"
                                           TextAlignment="Right">
                                    <Run Text="{Binding ElementName=DurationSlider, Path=Value, StringFormat={}{0:0}}" />
                                    <Run Text=" ms" Foreground="{StaticResource TextSecondary}" />
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="Position" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Where the OSD anchors on the primary screen." />
                                </StackPanel>
                                <ComboBox x:Name="PositionCombo"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ModernComboStyle}"
                                          ItemsSource="{Binding Source={StaticResource OsdPositions}}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowLastStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="Hover keep-alive" />
                                    <TextBlock Style="{StaticResource RowHintStyle}" Text="Pause the auto-hide timer while the mouse is over the OSD." />
                                </StackPanel>
                                <CheckBox x:Name="HoverToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}" />
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- ============== Audio ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Audio source" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <Border Style="{StaticResource RowLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Monitored Voicemeeter bus" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="Which bus drives the OSD. A1 is the default route the volume keys land on." />
                            </StackPanel>
                            <ComboBox x:Name="BusCombo"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ModernComboStyle}" />
                        </Grid>
                    </Border>
                </Border>

                <!-- ============== Media ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Media" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <Border Style="{StaticResource RowLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Show on track change" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="Off by default. When on, the OSD pops every time the current player advances or toggles play/pause." />
                            </StackPanel>
                            <CheckBox x:Name="AutoShowMediaToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                        </Grid>
                    </Border>
                </Border>

                <!-- ============== General ============== -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="General" Margin="4,18,0,10" />
                <Border Style="{StaticResource CardStyle}">
                    <Border Style="{StaticResource RowLastStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                <TextBlock Style="{StaticResource RowLabelStyle}" Text="Launch at Windows login" />
                                <TextBlock Style="{StaticResource RowHintStyle}" Text="Adds a per-user registry entry so Plith starts automatically." />
                            </StackPanel>
                            <CheckBox x:Name="AutoStartToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                        </Grid>
                    </Border>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer with keyboard hints -->
        <Border Grid.Row="3"
                Background="{StaticResource HeaderBg}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource KbdHintStyle}">
                        <TextBlock Style="{StaticResource KbdHintTextStyle}" Text="Esc" />
                    </Border>
                    <TextBlock Style="{StaticResource RowHintStyle}" Margin="8,0,16,0" Text="dismiss" VerticalAlignment="Center" />
                    <Border Style="{StaticResource KbdHintStyle}">
                        <TextBlock Style="{StaticResource KbdHintTextStyle}" Text="Enter" />
                    </Border>
                    <TextBlock Style="{StaticResource RowHintStyle}" Margin="8,0,0,0" Text="save" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource GhostButtonStyle}" Content="Cancel" Margin="0,0,10,0" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Content="Save changes" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
