<Window x:Class="Plith.Views.PositionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B0000000"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Focusable="True">
    <Window.Resources>
        <!-- Hotspot dot: 96 DIP circle, lime accent, animates on hover -->
        <Style x:Key="HotspotStyle" TargetType="Border">
            <Setter Property="Width" Value="96" />
            <Setter Property="Height" Value="96" />
            <Setter Property="CornerRadius" Value="48" />
            <Setter Property="Background" Value="#20FFFFFF" />
            <Setter Property="BorderBrush" Value="#60FFFFFF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4ACAFF33" />
                    <Setter Property="BorderBrush" Value="#CAFF33" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HotspotSelectedStyle" TargetType="Border" BasedOn="{StaticResource HotspotStyle}">
            <Setter Property="Background" Value="#80CAFF33" />
            <Setter Property="BorderBrush" Value="#CAFF33" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>

        <!-- Big pill buttons at the bottom of the overlay -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="28,12" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#CAFF33" />
            <Setter Property="Foreground" Value="#0D0D0D" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="#30FFFFFF" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Full-canvas click surface: click anywhere places the OSD at that point.
             Hotspots sit on top and win the hit-test through Handled=true. -->
        <Canvas x:Name="ClickCanvas" Background="Transparent" />

        <!-- Header + toolbar get REPOSITIONED at runtime by RelocateChrome() so the
             OSD you're dragging never sits on top of them. Whichever horizontal side
             is opposite the OSD wins the chrome. -->
        <StackPanel x:Name="HeaderPanel"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="24,20,0,0">
            <TextBlock Text="Set OSD position"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold" />
            <TextBlock x:Name="HintLabel"
                       Text="Drag the OSD. Release near a lime hotspot to snap. Alt = free. Click a hotspot to jump."
                       Foreground="#B0FFFFFF"
                       FontSize="12"
                       Margin="0,4,0,0"
                       MaxWidth="360"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel x:Name="ToolbarPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,24,20">
            <Button x:Name="CancelButton"
                    Content="Cancel (Esc)"
                    AutomationProperties.Name="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}" />
            <Button x:Name="SaveButton"
                    Content="Save (Enter)"
                    AutomationProperties.Name="Save position"
                    Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
