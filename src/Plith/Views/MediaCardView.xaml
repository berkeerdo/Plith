<UserControl x:Class="Plith.Views.MediaCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MediaViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- Transport buttons — tight, icon-only, hover/pressed states only via background -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource OsdTextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource OsdHighlight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause gets accent treatment so it reads as the primary action -->
        <Style x:Key="PlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="17"
                                Background="{DynamicResource OsdHighlight}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource OsdTextPrimary}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Album art with subtle drop shadow + rounded clip -->
        <Border Grid.Column="0"
                Width="44" Height="44"
                CornerRadius="8"
                Background="#22FFFFFF"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid>
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="{DynamicResource OsdTextTertiary}"
                           Text="&#xE940;"
                           Visibility="{Binding HasAlbumArt, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <Image Source="{Binding AlbumArt}"
                       Stretch="UniformToFill"
                       Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Title + Artist -->
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
            <TextBlock Style="{StaticResource OsdTrackNameStyle}"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Title}" />
            <TextBlock Style="{StaticResource OsdTrackArtistStyle}"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding Artist}" />
        </StackPanel>

        <!-- Transport controls — prev / play-pause (primary) / next -->
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button x:Name="PrevButton"
                    Style="{StaticResource MediaButtonStyle}"
                    Content="&#xE892;"
                    ToolTip="Previous" />
            <Button x:Name="PlayPauseButton"
                    Style="{StaticResource PlayPauseButtonStyle}"
                    Margin="2,0"
                    Content="{Binding PlayPauseGlyph}"
                    ToolTip="Play / Pause" />
            <Button x:Name="NextButton"
                    Style="{StaticResource MediaButtonStyle}"
                    Content="&#xE893;"
                    ToolTip="Next" />
        </StackPanel>
    </Grid>
</UserControl>
