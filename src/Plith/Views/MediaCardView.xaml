<UserControl x:Class="Plith.Views.MediaCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             xmlns:w="clr-namespace:Plith.Views.Widgets"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:MediaViewModel}"
             mc:Ignorable="d"
             AutomationProperties.Name="{Binding AccessibleSummary}"
             AutomationProperties.LiveSetting="Polite">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- Icons drawn for this product. The font this card used - "Segoe Fluent Icons, Segoe
             MDL2 Assets" - ships different contents on different Windows builds, and slice 2
             found that out the expensive way when seven of ten weather glyphs picked from it
             turned out not to exist at all. A PathGeometry cannot go missing. -->
        <!-- No Stretch. Each mark is drawn on the shared 24 grid inside a Viewbox, so they are
             all scaled by the same factor - per-Path Stretch scaled each geometry's OWN bounds
             to the box, which made play visibly larger than pause for no reason a person could
             name. -->
        <Style x:Key="TransportIconStyle" TargetType="Path">
            <!-- Follows the button's Foreground, so the hover and disabled states keep working
                 exactly as they did when this was a glyph inheriting TextElement.Foreground. -->
            <Setter Property="Fill"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- Transport buttons — tight, icon-only, hover/pressed states only via background -->
        <Style x:Key="MediaButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource OsdTextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="16"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource OsdHighlight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause gets accent treatment so it reads as the primary action -->
        <Style x:Key="PlayPauseButtonStyle" TargetType="Button" BasedOn="{StaticResource MediaButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                CornerRadius="17"
                                Background="{DynamicResource OsdHighlight}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource OsdTextPrimary}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The AutomationProperties for this card sit on the UserControl root above, not here:
         WPF gives a Grid no automation peer, so a name set here never reaches UI Automation.
         See LiveRegionAnnouncer for the measurement behind that. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Album art with subtle drop shadow + rounded clip -->
        <Border Grid.Column="0"
                Width="36" Height="36"
                CornerRadius="6"
                Background="#22FFFFFF"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid>
                <!-- Decorative album-art placeholder glyph: automation name explicitly empty -->
                <!-- Decorative placeholder. A Path has no automation peer at all, which is the
                     honest version of what the AutomationProperties.Name="" on the TextBlock
                     here was reaching for - and never achieved, because GetNameCore treats an
                     empty name as unset and falls through to the glyph's own text. -->
                <Path HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="20" Height="20" Stretch="Uniform"
                      Data="{StaticResource IconDisc}"
                      Fill="{DynamicResource OsdTextTertiary}"
                      Visibility="{Binding HasAlbumArt, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                <Image Source="{Binding AlbumArt}"
                       Stretch="UniformToFill"
                       Visibility="{Binding HasAlbumArt, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <!-- Title + Artist -->
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
            <!-- Scrolls rather than ellipses, and only when it has to. The same MarqueeText the
                 notch's media page uses, not a second implementation: a title must not be
                 written one way on one surface and another way on the other, and the four rules
                 that keep a marquee from being irritating are worth having in one place.

                 MarqueeText declares its own FontSize, FontWeight, FontFamily and Foreground.
                 It relied on TextElement.* inheritance at first and the title came out in the
                 TextBlock's default black - invisible on this card. A control that builds its
                 own visual children is exactly where that inheritance quietly does not arrive. -->
            <!-- Sizes and weights copied from OsdTrackNameStyle / OsdTrackArtistStyle rather
                 than re-chosen: this task changes HOW a long title behaves, not how any title
                 looks, and a silent point-size change would be a second edit hiding inside the
                 first. -->
            <w:MarqueeText Height="20"
                           FontFamily="{StaticResource OsdUiFont}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource OsdTextPrimary}"
                           Text="{Binding Title}" />
            <w:MarqueeText Height="17"
                           Margin="0,3,0,0"
                           FontFamily="{StaticResource OsdUiFont}"
                           FontSize="12"
                           Foreground="{DynamicResource OsdTextSecondary}"
                           Text="{Binding Artist}" />
        </StackPanel>

        <!-- Transport controls — prev / play-pause (primary) / next -->
        <StackPanel Grid.Column="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Button x:Name="PrevButton"
                    Style="{StaticResource MediaButtonStyle}"
                    AutomationProperties.Name="Previous track"
                    ToolTip="Previous">
                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
                    <Path Style="{StaticResource TransportIconStyle}" Data="{StaticResource IconPrevious}" />
                </Canvas></Viewbox>
            </Button>
            <Button x:Name="PlayPauseButton"
                    Style="{StaticResource PlayPauseButtonStyle}"
                    Margin="2,0"
                    AutomationProperties.Name="{Binding PlayPauseLabel}"
                    ToolTip="Play / Pause">
                <!-- The shape is chosen from the state here rather than from a code point on the
                     view model. PlayPauseGlyph was a Segoe MDL2 character and goes with the font. -->
                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Data" Value="{StaticResource IconPlay}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Data" Value="{StaticResource IconPause}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                </Canvas></Viewbox>
            </Button>
            <Button x:Name="NextButton"
                    Style="{StaticResource MediaButtonStyle}"
                    AutomationProperties.Name="Next track"
                    ToolTip="Next">
                <Viewbox Width="15" Height="15"><Canvas Width="24" Height="24">
                    <Path Style="{StaticResource TransportIconStyle}" Data="{StaticResource IconNext}" />
                </Canvas></Viewbox>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
