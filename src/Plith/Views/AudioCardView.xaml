<UserControl x:Class="Plith.Views.AudioCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:AudioCardViewModel}"
             mc:Ignorable="d"
             AutomationProperties.Name="{Binding AccessibleSummary}"
             AutomationProperties.LiveSetting="Polite">
    <!-- The two AutomationProperties above belong on this UserControl root and nowhere else:
         WPF gives a Grid no automation peer, so a name set there never reaches UI Automation.
         See LiveRegionAnnouncer for the measurement behind that. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/PlithIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <!-- The speaker carries the state on its own, so "is my sound off?" is answered
                 without reading a number: crossed when muted, one wave when quiet, two when not.
                 Drawn rather than set from a font - see PlithIcons.xaml. -->
            <!-- One Viewbox over one Canvas: every part shares the 24-grid the geometry was
                 drawn on, and the Viewbox scales that grid once. Per-Path Stretch made each
                 piece fill the box on its own, so a 4-unit wave came out the size of the cone
                 and they stacked into a blob.

                 Stroked, matching the design. -->
            <Viewbox DockPanel.Dock="Left" Width="21" Height="21" Margin="0,0,10,0"
                     VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource IconSpeakerBody}"
                          Stroke="{DynamicResource OsdTextPrimary}"
                          StrokeThickness="1.6" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path Data="{StaticResource IconSpeakerWaveInner}"
                          Stroke="{DynamicResource OsdTextPrimary}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding Muted, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Path Data="{StaticResource IconSpeakerWaveOuter}"
                          Stroke="{DynamicResource OsdTextPrimary}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Muted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsQuiet}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                    <Path Data="{StaticResource IconMuteCross}"
                          Stroke="{DynamicResource OsdTextPrimary}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="{Binding Muted, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Canvas>
            </Viewbox>

            <TextBlock DockPanel.Dock="Right"
                       Style="{StaticResource OsdValueStyle}"
                       VerticalAlignment="Center"
                       Text="{Binding GainText}" />

            <!-- The device, then which rail it is. On a machine running Voicemeeter alongside
                 Sonar alongside a headset, a number with no rail attached to it is ambiguous. -->
            <!-- The device reads as a name and the rail reads as a label, which is the way
                 round the design has it. They were swapped: the device carried the small-caps
                 style meant for the rail, so the thing a person reads first was set in the
                 treatment reserved for the thing they read second. -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource OsdUiFont}"
                           FontSize="12"
                           Foreground="{DynamicResource OsdTextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Label}" />
                <TextBlock FontFamily="{StaticResource OsdUiFont}"
                           FontSize="10"
                           Margin="0,1,0,0"
                           Typography.Capitals="AllSmallCaps"
                           Foreground="{DynamicResource OsdTextTertiary}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding BusLine}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Height="6">
            <Border CornerRadius="3" Background="{DynamicResource OsdTrackBg}" />
            <Border HorizontalAlignment="Left"
                    CornerRadius="3"
                    Background="{Binding GainColor}">
                <!-- The glow is what lifts the fill off the card. Its colour follows the fill,
                     so it changes with the threshold rather than staying green over an amber
                     bar. -->
                <Border.Effect>
                    <!-- FallbackValue because GainColor is typed as Brush: every value it
                         actually returns is a SolidColorBrush, but a binding to .Color on
                         anything else would resolve to nothing and paint a black halo. -->
                    <DropShadowEffect ShadowDepth="0" BlurRadius="9" Opacity="0.55"
                                      Color="{Binding GainColor.Color, FallbackValue=Transparent}" />
                </Border.Effect>
                <Border.Width>
                    <MultiBinding>
                        <MultiBinding.Converter>
                            <vm:NormalizedToWidthConverter />
                        </MultiBinding.Converter>
                        <Binding Path="GainNormalized" />
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                    </MultiBinding>
                </Border.Width>
            </Border>

            <!-- The caution tick, drawn only as the level approaches it.

                 It gives the colour change a cause. Without it the bar simply turns amber at
                 85 %, which reads as a glitch; with it, the mark is already there and the fill
                 arrives at it. Its position comes from the same constant the colour logic uses,
                 so the mark and the change cannot end up in different places.

                 Visibility is bound to a property DERIVED from the level rather than set in a
                 change handler - the defect class this branch keeps producing is a value
                 latched at a moment that turned out to be the wrong one. -->
            <!-- Positioned by an invisible spacer rather than a TranslateTransform. A binding
                 on a Freezable does resolve through the inheritance context, but it is the kind
                 of thing that fails silently and draws the mark at zero, and this is the one
                 element whose position has to be right. A spacer uses ordinary DataContext
                 inheritance and the converter the fill already uses. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        Visibility="{Binding IsNearThreshold, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="Transparent">
                    <Border.Width>
                        <MultiBinding>
                            <MultiBinding.Converter>
                                <vm:NormalizedToWidthConverter />
                            </MultiBinding.Converter>
                            <Binding Path="CautionThresholdPosition" />
                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                        </MultiBinding>
                    </Border.Width>
                </Border>
                <Border Width="1.5" CornerRadius="1" Margin="0,-2,0,-2" Background="#47FFFFFF" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
