<UserControl x:Class="Plith.Views.OsdContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             xmlns:views="clr-namespace:Plith.Views"
             d:DataContext="{d:DesignInstance Type=vm:OsdViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="440"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">
    <!-- Outer margin reserves space for the drop-shadow so it doesn't get clipped at window bounds.
         Background=Transparent so the whole area (including margins) accepts hit-tests -
         needed by the position editor's drag grab, which was only firing on the inner Border. -->
    <Grid Margin="14" Background="Transparent">
        <Border CornerRadius="14"
                Padding="20,16"
                Background="{DynamicResource OsdSurfaceBrush}"
                BorderBrush="{DynamicResource OsdBorder}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="28" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Vertical">

                <!-- Media row. The Visibility binding lives on the wrapper Border so it can
                     resolve against OsdViewModel; the inner MediaCardView overrides DataContext to
                     Media for its own bindings. -->
                <Border Visibility="{Binding ShowMediaCard, Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:MediaCardView x:Name="MediaCardControl"
                                         DataContext="{Binding Media}" />
                </Border>

                <!-- Divider between media + volume; collapses with the card -->
                <Border Height="1"
                        Margin="0,14,0,14"
                        Background="{DynamicResource OsdDivider}"
                        Visibility="{Binding ShowMediaCard, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Volume row -->
                <views:AudioCardView DataContext="{Binding Audio}" />

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
