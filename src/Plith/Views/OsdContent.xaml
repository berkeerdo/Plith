<UserControl x:Class="Plith.Views.OsdContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:OsdShellViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="440"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True">
    <Grid ClipToBounds="True">
        <!-- The notch surface. Collapsed it is a narrow pill flush with the top of the screen;
             expanded it is the panel the card content sits in. It is ONE Border whose Width,
             Height, corner radius and shadow are all written from code-behind by
             ApplyNotchExpand() off a single progress value.

             Why a separate element from CardSurface rather than morphing CardSurface itself:
             this Border has no children, so animating its size re-measures nothing but itself.
             The card content beside it keeps a fixed layout for the whole animation and is
             merely faded in, which is both cheaper per frame and the reason the content does
             not visibly reflow while the shape is still moving.

             Collapsed in the designer and for Classic, which never shows it - Classic's card
             is CardSurface below, exactly as it was in 0.1.5. -->
        <Border x:Name="NotchSurface"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Visibility="Collapsed"
                CornerRadius="0,0,8,8"
                Background="{DynamicResource NotchBezelBrush}"
                BorderThickness="0"
                SnapsToDevicePixels="True">
            <!-- Direction 270 is straight down in WPF's counter-clockwise-from-east convention.
                 A surface flush with the top of the monitor has nothing above it for a blur to
                 fall on, so an even shadow would just render as a grey smear along the edge.
                 Opacity is driven from code and is zero while collapsed: a bezel casts no
                 shadow, and on a 2 DIP resting pill a blur is most of what you would see. -->
            <Border.Effect>
                <DropShadowEffect x:Name="NotchShadow" ShadowDepth="6" Direction="270"
                                  BlurRadius="20" Opacity="0" Color="Black" />
            </Border.Effect>
        </Border>

        <!-- The card content.

             This Grid is the file's existing outer content Grid. Its Margin="14" and
             Background="Transparent" keep their original reasons: the margin reserves
             drop-shadow space so it is not clipped at the window bounds, and the transparent
             background makes the whole area including the margin accept hit-tests, which the
             position editor's drag grab needs (it was only firing on the inner Border before).

             In notch mode its Opacity is driven by ApplyNotchExpand(): the content is absent
             while the shape grows and fades in over the tail of the expansion. In Classic it
             stays at 1 and the window's own Opacity does the fading, unchanged from 0.1.5. -->
        <Grid x:Name="SlidingRoot" Margin="14" Background="Transparent">

            <!-- Corner radius, border thickness and shadow are all set from code-behind by
                 SetNotchLook(), because the two presentation modes want genuinely different
                 shapes and the difference is not cosmetic:

                 Classic is a floating card - rounded on all four corners, inset from every
                 window edge, with an even drop shadow. It is the 0.1.5 look and must not
                 change.

                 In notch mode this Border draws NOTHING: no background, no border, no shadow.
                 NotchSurface behind it is the visible surface, and the two are laid out to
                 coincide exactly when the notch is fully open. Letting both paint would double
                 every edge and stack two shadows.

                 The values below are Classic's, and are what the designer sees; SetNotchLook()
                 overwrites them at runtime. -->
            <Border x:Name="CardSurface"
                    CornerRadius="14"
                    Padding="20,16"
                    Background="{DynamicResource OsdSurfaceBrush}"
                    BorderBrush="{DynamicResource OsdBorder}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect x:Name="CardShadow" ShadowDepth="0" BlurRadius="28" Opacity="0.55" Color="Black" />
                </Border.Effect>

                <!-- The card stack. CardHost decides membership and order; each item's view is
                     resolved from its view-model type by the implicit DataTemplates in
                     Resources/CardTemplates.xaml. AlternationCount="64" is what makes
                     ItemsControl.AlternationIndex report a true index rather than cycling;
                     64 is far above any plausible card count, not a card limit. -->
                <ItemsControl ItemsSource="{Binding VisibleCards}" AlternationCount="64">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Tag carries this item's AlternationIndex so the trigger below can read it.
                                 DO NOT "simplify" by moving the RelativeSource binding into the DataTrigger:
                                 a template trigger evaluates against the item container itself, so its
                                 FindAncestor search starts at the container's PARENT and walks straight past
                                 the item's own ContentPresenter to one further up the tree, where
                                 ItemsControl.AlternationIndex is unset and returns its default 0 — which
                                 collapses the divider on EVERY card. An element-level binding starts at this
                                 StackPanel and finds the right container. -->
                            <StackPanel x:Name="ItemRoot"
                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                      Path=(ItemsControl.AlternationIndex)}">
                                <!-- Separator above every card except the first. In 0.1.5 the divider sat
                                     between the media row and the volume row with this exact margin; placing
                                     it above each non-first card reproduces that spacing. A Collapsed element
                                     contributes nothing to StackPanel layout, so the single-card case is
                                     byte-identical to the old collapsed-divider case. -->
                                <Border x:Name="Divider" Height="1" Margin="0,14,0,14"
                                        Background="{DynamicResource OsdDivider}" />
                                <ContentControl Content="{Binding ViewModel}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="0" Binding="{Binding ElementName=ItemRoot, Path=Tag}">
                                    <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- The widget surface. A click on the resting notch opens THIS; an event opens the
                 card stack above. The two are never on screen together, and which one is showing
                 is what tells a person whether they went somewhere or were answered.

                 A sibling of CardSurface rather than a page inside it, because the frame brings
                 its own fixed size: with the card stack collapsed, the content's measured size
                 IS the frame plus the insets, so the existing measure-and-morph path sizes the
                 notch to it without a second code path. Collapsed by default, including in the
                 designer and in Classic, which never shows it. -->
            <ContentControl x:Name="WidgetHost"
                            Visibility="Collapsed"
                            Focusable="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top" />

            <!-- The event HUD. Third of the three things this panel can be, and the only one an
                 event ever produces in notch mode. Sized by the HUD view itself, which changes
                 shape between its volume and media kinds. -->
            <ContentControl x:Name="HudHost"
                            Visibility="Collapsed"
                            Focusable="False"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top" />
        </Grid>
    </Grid>
</UserControl>
