<UserControl x:Class="Plith.Views.AmbientCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             xmlns:services="clr-namespace:Plith.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AmbientCardViewModel}"
             AutomationProperties.Name="{Binding AccessibleSummary}"
             AutomationProperties.LiveSetting="Polite">
    <!-- The two AutomationProperties above belong on this UserControl root and nowhere else,
         same as AudioCardView/MediaCardView: WPF gives Grid/StackPanel no automation peer, so
         a name set on either never reaches UI Automation. AccessibleSummary is composed from
         every column that currently has content — see AmbientCardViewModel — rather than named
         per column, because the columns themselves are peerless panels. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Clock. The TextBlocks carry no automation name of their own: TextBlock does own a
             peer and names itself from its own Text by default, which would announce "14:05"
             and "7 September" a second time, disconnected from the card-level summary above.
             Explicitly empty neutralises that, matching the album-art glyph in
             MediaCardView.xaml. -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding ClockTime}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OsdTextPrimary}"
                       AutomationProperties.Name="" />
            <TextBlock Text="{Binding ClockDate}"
                       FontSize="11"
                       Foreground="{DynamicResource OsdTextSecondary}"
                       AutomationProperties.Name="" />
        </StackPanel>

        <!-- Weather. Collapsed rather than blanked when there is no fresh snapshot, same rule
             as the battery column below. No AutomationProperties.Name here either: this
             StackPanel is just as peerless as every other panel in this file, so a name set on
             it would never reach UI Automation — the weather segment is appended to
             AmbientCardViewModel.AccessibleSummary, bound on the UserControl root above. -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasWeather, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding WeatherGlyph}"
                       FontFamily="{x:Static services:WeatherCodeMap.GlyphFontFamilyName}"
                       FontSize="14"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}"
                       AutomationProperties.Name="" />
            <TextBlock Text="{Binding WeatherText}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}"
                       AutomationProperties.Name="" />
        </StackPanel>

        <!-- Battery. Collapsed rather than blanked when there is no battery: a collapsed
             element contributes nothing to the Grid, so a desktop's row is genuinely two
             columns wide instead of two columns and a gap. No AutomationProperties.Name here
             on purpose — this StackPanel is peerless like every other panel in this file, so
             a name set on it would never reach UI Automation. The reading lives entirely in
             AmbientCardViewModel.AccessibleSummary, bound on the UserControl root above. -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="&#xE83E;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}"
                       AutomationProperties.Name=""
                       Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding BatteryText}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}"
                       AutomationProperties.Name="" />
        </StackPanel>
    </Grid>
</UserControl>
