<UserControl x:Class="Plith.Views.AmbientCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AmbientCardViewModel}"
             AutomationProperties.Name="Time">
    <!-- AutomationProperties.Name belongs on this UserControl root and nowhere else: WPF
         gives a StackPanel no automation peer (check-a11y.ps1's peerless list), so a name
         set there never reaches UI Automation, same as AudioCardView/MediaCardView. Fixed
         at "Time" while the clock is the only column; Tasks 3 and 7 will need to revisit
         this into a per-column scheme once weather and battery exist alongside it. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Clock. Two lines (time, then a year-less date) read together as one thing by
             virtue of the card-level AutomationProperties.Name above. -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding ClockTime}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OsdTextPrimary}" />
            <TextBlock Text="{Binding ClockDate}"
                       FontSize="11"
                       Foreground="{DynamicResource OsdTextSecondary}" />
        </StackPanel>

        <!-- Columns 1 and 2 are filled by Tasks 3 and 7. Left empty here deliberately: this
             task ships a working clock rather than three half-built columns. -->
    </Grid>
</UserControl>
