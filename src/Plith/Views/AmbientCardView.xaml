<UserControl x:Class="Plith.Views.AmbientCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plith.ViewModels"
             xmlns:services="clr-namespace:Plith.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AmbientCardViewModel}"
             AutomationProperties.Name="{Binding AccessibleSummary}"
             AutomationProperties.LiveSetting="Polite">
    <!-- The two AutomationProperties above belong on this UserControl root and nowhere else,
         same as AudioCardView/MediaCardView: WPF gives Grid/StackPanel no automation peer, so
         a name set on either never reaches UI Automation. AccessibleSummary is composed from
         every column that currently has content — see AmbientCardViewModel — rather than named
         per column, because the columns themselves are peerless panels.

         Every TextBlock below DOES own an automation peer, though, and TextBlockAutomationPeer
         falls through to the element's own Text whenever AutomationProperties.Name is unset —
         including set to the empty string, which is not the same as "no name" to WPF. An
         AutomationProperties.Name="" was tried on each of them, on the theory that it would
         keep Narrator from re-announcing content the live-region summary above had just
         spoken. It is inert, was removed, and is not replaced with anything: the review that
         suggested AutomationProperties.AccessibilityView="Raw" (WinUI/UWP's answer to this
         same problem) was checked against WPF's actual API surface — reflecting over
         System.Windows.Automation.AutomationProperties in PresentationCore.dll lists Name,
         HelpText, LabeledBy, LiveSetting, ItemStatus, IsOffscreenBehavior and so on, but no
         AccessibilityView — and WPF has no equivalent. The only way to pull a TextBlock out of
         the automation tree here is UIElement.OnCreateAutomationPeer returning null on a
         custom control, which is a bigger change than this fix warrants. So Narrator speaks
         the card's live-region summary and then re-announces "14:05", "7 September", the
         weather glyph character, "21°  Clear" and the battery percentage individually — a
         duplicate announcement accepted as a known limitation, not fixed. (MediaCardView.xaml
         carries the same inert idiom in one place; it predates this branch and is left as-is.) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Clock. See the root comment above for why these TextBlocks carry no
             AutomationProperties.Name override: WPF gives them no supported way to suppress
             the automation peer's own text-derived name, so Narrator announces "14:05" and
             "7 September" a second time after the card-level summary. Accepted, not fixed. -->
        <StackPanel Grid.Column="0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding ClockTime}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OsdTextPrimary}" />
            <TextBlock Text="{Binding ClockDate}"
                       FontSize="11"
                       Foreground="{DynamicResource OsdTextSecondary}" />
        </StackPanel>

        <!-- Weather. Collapsed rather than blanked when there is no fresh snapshot, same rule
             as the battery column below. This StackPanel is peerless (Grid/StackPanel own no
             automation peer in WPF), so it carries no AutomationProperties.Name of its own —
             the weather segment is appended to AmbientCardViewModel.AccessibleSummary, bound
             on the UserControl root above. Its child TextBlocks below duplicate that summary
             when Narrator reads them individually; see the root comment for why. -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasWeather, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding WeatherGlyph}"
                       FontFamily="{x:Static services:WeatherCodeMap.GlyphFontFamilyName}"
                       FontSize="14"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}" />
            <TextBlock Text="{Binding WeatherText}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}" />
        </StackPanel>

        <!-- Battery. Collapsed rather than blanked when there is no battery: a collapsed
             element contributes nothing to the Grid, so a desktop's row is genuinely two
             columns wide instead of two columns and a gap. Peerless StackPanel, same as
             Weather above, so it carries no AutomationProperties.Name of its own — the
             reading lives entirely in AmbientCardViewModel.AccessibleSummary, bound on the
             UserControl root above. Its child TextBlocks below duplicate that summary when
             Narrator reads them individually; see the root comment for why. -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasBattery, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="&#xE83E;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="12"
                       Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}"
                       Visibility="{Binding IsCharging, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock Text="{Binding BatteryText}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource OsdTextSecondary}" />
        </StackPanel>
    </Grid>
</UserControl>
