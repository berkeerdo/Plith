<Application x:Class="Plith.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ornament defaults, the OFF values. Merged BEFORE the OSD palette on purpose: a
                     later dictionary wins a duplicate key, so the Loft palettes below override
                     these to ON, and high contrast, which defines none of them, falls through to
                     OFF. Move this after the palette and no ornament ever draws. -->
                <ResourceDictionary Source="Resources/Ornaments.xaml" />
                <!-- OSD overlay palette. Swapped by ThemeService between OsdPalette.Dark.xaml
                     and OsdPalette.Light.xaml at runtime. Theme.xaml references every Osd*
                     brush via DynamicResource so the swap reaches the OSD window live. -->
                <ResourceDictionary Source="Resources/OsdPalette.Dark.xaml" />
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <!-- Settings window palette. Same dynamic-swap pattern as the OSD palette
                     above; SettingsTheme.xaml references every brush via DynamicResource. -->
                <ResourceDictionary Source="Resources/Palette.Dark.xaml" />
                <ResourceDictionary Source="Resources/SettingsTheme.xaml" />
                <!-- Card view templates. Merged last so the implicit DataTemplates can
                     reference brush keys declared by the palette/theme dictionaries above. -->
                <ResourceDictionary Source="Resources/CardTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
