<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <RootNamespace>Plith</RootNamespace>
    <AssemblyName>Plith</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>Plith.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Release builds pick the uiAccess=true manifest so install-local.ps1 + signtool can
         earn UIAccess from Windows after install to \Program Files\. Debug stays at false
         so unsigned dev launches (dotnet run from bin\) don't trip Windows' elevation check. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Release'">app.release.manifest</ApplicationManifest>
    <Authors>Plith</Authors>
    <Product>Plith</Product>
    <Description>Modern Windows audio OSD with Voicemeeter-first design and media controls baked in.</Description>
    <Version>0.3.2</Version>
    <ApplicationIcon>Resources\icons\plith.ico</ApplicationIcon>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!--
      Suppressions with justification:
      CA1707 — Win32 constants intentionally use ALL_CAPS_WITH_UNDERSCORES (WS_POPUP,
               WM_DESTROY, etc.) so they map 1:1 to MSDN documentation. Renaming
               obscures the interop contract.
      CA1838 — NativeFlyoutSuppressor uses StringBuilder for GetClassName; replacement
               by char[] is tracked but the suppressor itself is currently disabled
               (Explorer wedge issue). Re-evaluate when re-enabled in Phase 4 polish.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1838</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icons\plith.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built alongside Plith, but NOT referenced as an assembly: the catcher is a separate
         process on purpose and must not be linked into this one. ReferenceOutputAssembly=false
         gives the build ordering without the reference. -->
    <ProjectReference Include="../Plith.DropCatcher/Plith.DropCatcher.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!-- One definition of where the catcher's output lives, because the two targets below both
       need it and a glob that drifts between them is the defect this pair already produced once.
       It cannot be an ItemGroup out here: top-level globs evaluate before the catcher is built,
       so on a clean tree the item would come out empty. Hence a property, expanded inside each
       target where the files actually exist by then. -->
  <PropertyGroup>
    <DropCatcherOutputDir>$(MSBuildThisFileDirectory)../Plith.DropCatcher/bin/$(Configuration)/$(TargetFramework)</DropCatcherOutputDir>
  </PropertyGroup>

  <!-- The launcher looks for the catcher beside Plith.exe and nowhere else, so the build has to
       put it there. Without this the shelf is silently absent in every dev run: Plith starts, the
       pipe listens, and nothing ever connects. -->
  <Target Name="CopyDropCatcherBesidePlith" AfterTargets="Build">
    <ItemGroup>
      <DropCatcherOutput Include="$(DropCatcherOutputDir)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DropCatcherOutput)"
          DestinationFolder="$(OutDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- And the same again for publish, which is a SEPARATE file set that the target above never
       reached.
       The target above writes into $(OutDir), the build output. `dotnet publish` computes
       ResolvedFileToPublish on its own and does not sweep up files a custom target dropped into
       the build folder, so the published product had Plith.exe and no catcher beside it. Since
       scripts/manual-install.ps1 installs the PUBLISH output, every installed Plith answered a
       shelf drop with NotFound: the feature built, passed its tests, passed every lint, and did
       not exist in the shipped product. Measured at the console on 2026-09-19, against a
       C:\Program Files\Plith that had been missing the catcher since it was written.
       Everything is published, not a hand-picked list, so the installed layout matches the one
       dev runs against. A file that is present in one and absent in the other is exactly how
       this was missed. scripts/check-publish-shape.ps1 fails the moment it stops matching. -->
  <Target Name="PublishDropCatcherBesidePlith" BeforeTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <DropCatcherPublishOutput Include="$(DropCatcherOutputDir)/**/*" />
      <ResolvedFileToPublish Include="@(DropCatcherPublishOutput)">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="WpfScreenHelper" Version="1.1.0" />
    <PackageReference Include="ini-parser-netstandard" Version="2.5.2" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

</Project>
