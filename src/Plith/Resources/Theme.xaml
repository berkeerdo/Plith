<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Plith.ViewModels">

    <vm:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

    <FontFamily x:Key="OsdUiFont">Segoe UI Variable, Segoe UI</FontFamily>

    <!-- Surface gets a subtle gradient so the card has depth without losing the modern flat feel -->
    <LinearGradientBrush x:Key="OsdSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0181818" Offset="0" />
        <GradientStop Color="#F0111111" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OsdBorder" Color="#2A2A2A" />
    <SolidColorBrush x:Key="OsdHighlight" Color="#1AFFFFFF" />

    <SolidColorBrush x:Key="OsdTextPrimary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="OsdTextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="OsdTextTertiary" Color="#71717A" />

    <SolidColorBrush x:Key="OsdTrackBg" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="OsdAccent" Color="#4AD695" />
    <SolidColorBrush x:Key="OsdDivider" Color="#1AFFFFFF" />

    <!-- ============================================================
         Typography — OSD-specific styles. Tabular numbers for dB.
         ============================================================ -->

    <Style x:Key="OsdLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OsdUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OsdTextTertiary}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="OsdValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OsdUiFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OsdTextPrimary}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="OsdTrackNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OsdUiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OsdTextPrimary}" />
    </Style>

    <Style x:Key="OsdTrackArtistStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource OsdUiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource OsdTextSecondary}" />
    </Style>

    <!-- Back-compat names kept so legacy bindings still resolve -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F0181818" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TrackBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4AD695" />

    <Style x:Key="CardLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource OsdLabelStyle}" />
    <Style x:Key="CardValueStyle" TargetType="TextBlock" BasedOn="{StaticResource OsdValueStyle}" />

</ResourceDictionary>
