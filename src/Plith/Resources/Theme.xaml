<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Plith.ViewModels">

    <vm:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <vm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>

    <Color x:Key="SurfaceColor">#1C1C1C</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#CC1C1C1C" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F5" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9AA0A6" />
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4AD695" />

    <Style x:Key="CardLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    </Style>

    <Style x:Key="CardValueStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

</ResourceDictionary>
