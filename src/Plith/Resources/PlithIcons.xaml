<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Icons drawn for this product rather than taken from Segoe MDL2.

         Not only a matter of taste. A FontIcon bound to "Segoe MDL2 Assets" depends on a font
         whose contents differ between Windows builds, and slice 2 found that out the expensive
         way: seven of ten weather glyphs picked from it did not exist at all and would have
         rendered as tofu boxes on a user's machine. A PathGeometry cannot go missing.

         One language throughout: a 24 grid, and fills rather than strokes wherever a shape has
         to stay readable at 13 px - the transport marks, which turn to mud as outlines at that
         size. Stroked icons in this set carry their own stroke width at the call site. -->

    <Geometry x:Key="IconPrevious">M18,5.5 L18,18.5 L8.5,12 Z M5,5.5 L7,5.5 L7,18.5 L5,18.5 Z</Geometry>
    <Geometry x:Key="IconNext">M6,5.5 L6,18.5 L15.5,12 Z M17,5.5 L19,5.5 L19,18.5 L17,18.5 Z</Geometry>
    <Geometry x:Key="IconPlay">M7.5,5.2 L7.5,18.8 L18.6,12 Z</Geometry>
    <Geometry x:Key="IconPause">M9,5.5 L11.5,5.5 L11.5,18.5 L9,18.5 Z M14.5,5.5 L17,5.5 L17,18.5 L14.5,18.5 Z</Geometry>

    <!-- The speaker is two geometries rather than one, because its body wants a fill and its
         waves want a stroke, and a single Path cannot have a different treatment per subpath.
         The call site stacks them; splitting here is also what lets the wave count change
         between the loud, quiet and muted states without redrawing the cone. -->
    <!-- A sun: the disc as two half arcs, then eight rays. One stroked Geometry rather than a
         group, because every other icon here is a path string and the call site supplies the
         stroke width. -->
    <Geometry x:Key="IconBrightness">M7.5,12 A4.5,4.5 0 1 1 16.5,12 A4.5,4.5 0 1 1 7.5,12 M12,1.8 L12,4.2 M12,19.8 L12,22.2 M1.8,12 L4.2,12 M19.8,12 L22.2,12 M4.75,4.75 L6.45,6.45 M17.55,17.55 L19.25,19.25 M19.25,4.75 L17.55,6.45 M6.45,17.55 L4.75,19.25</Geometry>

    <Geometry x:Key="IconSpeakerBody">M4,9.5 L7.2,9.5 L12,5.5 L12,18.5 L7.2,14.5 L4,14.5 Z</Geometry>
    <Geometry x:Key="IconSpeakerWaveInner">M15.6,9.4 A3.6,3.6 0 0 1 15.6,14.6</Geometry>
    <Geometry x:Key="IconSpeakerWaveOuter">M18.2,6.8 A7.2,7.2 0 0 1 18.2,17.2</Geometry>
    <Geometry x:Key="IconMuteCross">M16,9.6 L20.4,14.4 M20.4,9.6 L16,14.4</Geometry>

    <!-- Album-art placeholder. A disc rather than a musical note: the note says "music", but
         this stands in for artwork, and a disc is what is missing. Even-odd so the spindle hole
         is a hole rather than a second filled circle. -->
    <!-- Window caption marks. Strokes at the call site, so the 1.2 weight they want at 10 px
         is not baked in at the size the OSD's icons use. -->
    <Geometry x:Key="IconMinimize">M5,12 L19,12</Geometry>
    <Geometry x:Key="IconMaximize">M5.5,5.5 L18.5,5.5 L18.5,18.5 L5.5,18.5 Z</Geometry>
    <Geometry x:Key="IconClose">M6,6 L18,18 M18,6 L6,18</Geometry>

    <!-- Accent-swatch marks, built in code by SettingsWindow. -->
    <Geometry x:Key="IconCheck">M5,12.6 L9.6,17.2 L19,7.4</Geometry>
    <Geometry x:Key="IconPlus">M12,5.5 L12,18.5 M5.5,12 L18.5,12</Geometry>

    <!-- Charging. A bolt rather than a plug: the plug reads as "connected", which is what a
         person already knows from the cable in their hand. -->
    <Geometry x:Key="IconBolt">M13.4,3 L6.6,13.4 L11.2,13.4 L10.2,21 L17.4,10.4 L12.6,10.4 Z</Geometry>

    <!-- A cloud silhouette, on an 80 x 36 box.

         The sky used to draw its clouds as Ellipse - flat ovals, which is what they looked like.
         A cloud reads as a cloud because of its profile: a flat base and a run of bulges of
         different sizes along the top, largest off-centre. This is that, as one closed figure so
         it can take a single gradient rather than showing the seams between overlapping circles. -->
    <Geometry x:Key="ShapeCloud">M7,36 C3,36 0,32.4 0,28 C0,23.4 3.4,19.6 7.8,19.1 C8.4,10.6 15.4,4 24,4 C31.2,4 37.4,8.6 39.6,15.1 C42.2,12.2 46,10.4 50.2,10.4 C58.1,10.4 64.5,16.8 64.5,24.7 C64.5,25.2 64.5,25.7 64.4,26.2 C72.9,26.6 79.7,30.9 79.7,36 Z</Geometry>

    <!-- The microphone, and the stroke that crosses it out.

         Separate parts for the same reason the speaker is: a muted mic is the mic AND the cross,
         so there is no second drawing to keep in step when one of them changes. -->
    <Geometry x:Key="IconMic">M12,3.4 A3.1,3.1 0 0 1 15.1,6.5 L15.1,11.6 A3.1,3.1 0 0 1 8.9,11.6 L8.9,6.5 A3.1,3.1 0 0 1 12,3.4 Z</Geometry>
    <Geometry x:Key="IconMicStand">M6.4,11.2 A5.6,5.6 0 0 0 17.6,11.2 M12,16.8 L12,20.6 M8.6,20.6 L15.4,20.6</Geometry>
    <Geometry x:Key="IconMicCross">M4.4,3.6 L19.6,20.4</Geometry>

    <!-- Weather marks. Drawn as separate parts so a condition can be composed from them - a sun
         behind a cloud is the sun and the cloud, not a third drawing to keep in step with both. -->
    <Geometry x:Key="IconWxSun">M12,7.2 A4.8,4.8 0 1 1 11.99,7.2 Z</Geometry>
    <Geometry x:Key="IconWxRays">M12,1.6 L12,4.2 M12,19.8 L12,22.4 M1.6,12 L4.2,12 M19.8,12 L22.4,12 M4.6,4.6 L6.4,6.4 M17.6,17.6 L19.4,19.4 M19.4,4.6 L17.6,6.4 M6.4,17.6 L4.6,19.4</Geometry>
    <Geometry x:Key="IconWxCloud">M7.4,18.4 A4.2,4.2 0 0 1 7.8,10.1 A5.6,5.6 0 0 1 18.4,11.2 A3.6,3.6 0 0 1 17.8,18.4 Z</Geometry>
    <Geometry x:Key="IconWxMoon">M19,14.6 A7.6,7.6 0 1 1 10.4,5.2 A6.2,6.2 0 0 0 19,14.6 Z</Geometry>
    <Geometry x:Key="IconWxDrop">M12,3.6 C15.4,8.2 17.4,11.1 17.4,13.6 A5.4,5.4 0 1 1 6.6,13.6 C6.6,11.1 8.6,8.2 12,3.6 Z</Geometry>
    <Geometry x:Key="IconWxFlake">M12,3 L12,21 M4.2,7.5 L19.8,16.5 M4.2,16.5 L19.8,7.5</Geometry>
    <Geometry x:Key="IconWxBolt">M13.4,3 L6.6,13.4 L11.2,13.4 L10.2,21 L17.4,10.4 L12.6,10.4 Z</Geometry>

    <Geometry x:Key="IconDisc">F0 M12,3 A9,9 0 1 1 11.99,3 Z M12,9.6 A2.4,2.4 0 1 0 12.01,9.6 Z</Geometry>
</ResourceDictionary>
