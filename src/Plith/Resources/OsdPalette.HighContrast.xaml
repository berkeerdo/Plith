<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High-contrast OSD overlay palette. Every brush maps to a SystemColors key so the
         OSD follows whichever high-contrast theme (and colour scheme) the user picked in
         Windows, instead of painting its own colours over it. Paired key-for-key with
         OsdPalette.Dark. Border and divider are given full opacity here — their dark/light
         counterparts are alpha-blended, which is exactly what makes them vanish against a
         high-contrast background. -->

    <SolidColorBrush x:Key="OsdSurfaceBrush" Color="{x:Static SystemColors.WindowColor}" />

    <SolidColorBrush x:Key="OsdBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="OsdHighlight" Color="{x:Static SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="OsdTextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="OsdTextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="OsdTextTertiary" Color="{x:Static SystemColors.GrayTextColor}" />

    <SolidColorBrush x:Key="OsdTrackBg" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="OsdAccent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="OsdDivider" Color="{x:Static SystemColors.WindowTextColor}" />

    <!-- High contrast has no palette for a green/amber/red loudness scale — inventing one
         defeats the mode. The bar collapses to a single system colour (Highlight) and the
         numeric readout carries the value; only the muted state gets a distinct colour so
         it still reads as "off" rather than just quiet. -->
    <SolidColorBrush x:Key="OsdGainMuted" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="OsdGainGreen" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="OsdGainAmber" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="OsdGainRed" Color="{x:Static SystemColors.HighlightColor}" />

</ResourceDictionary>
