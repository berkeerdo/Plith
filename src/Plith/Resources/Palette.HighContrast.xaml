<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- High-contrast Settings palette. Same key shape as Palette.Dark, but every brush
         maps to a SystemColors key so the window follows the user's chosen high-contrast
         theme instead of the app's own baked-in surface/accent colours.

         ErrorText/WarningAmber map to WindowTextColor, NOT HighlightColor, even though the
         OSD's OsdGain* triad (see OsdPalette.HighContrast.xaml) does map to HighlightColor.
         The two look similar but are not the same problem: OsdGain* IS the active fill of
         the volume bar, with nothing else in that view competing for the accent colour, so
         collapsing it onto Highlight is safe and brief-mandated. ErrorText/WarningAmber sit
         in the same window as Accent/AccentHover/AccentPressed/AccentGlow (ordinary buttons
         and sliders) — putting a status colour on the same brush as an interactive control
         would make an error or warning read as clickable. Both usages already sit next to
         explanatory text (the hotkey conflict message, the "Game mode: Limited" label), so
         WindowTextColor loses no information a user actually reads. Do not "unify" these two
         groups — they diverge on purpose. -->

    <SolidColorBrush x:Key="WindowBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="HeaderBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CardBg" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CardBgHover" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="CardBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="CardBorderStrong" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Divider" Color="{x:Static SystemColors.WindowTextColor}" />

    <SolidColorBrush x:Key="TextPrimary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="TextTertiary" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{x:Static SystemColors.GrayTextColor}" />

    <SolidColorBrush x:Key="Accent" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentPressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="AccentGlow" Color="{x:Static SystemColors.HighlightColor}" />

    <SolidColorBrush x:Key="TrackInactive" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="ThumbColor" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="OverlayHover" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="OverlayPressed" Color="{x:Static SystemColors.ControlColor}" />

    <SolidColorBrush x:Key="ButtonGhost" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="ButtonGhostHover" Color="{x:Static SystemColors.ControlColor}" />

    <SolidColorBrush x:Key="ErrorText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="WarningAmber" Color="{x:Static SystemColors.WindowTextColor}" />

</ResourceDictionary>
