<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light palette — same key shape as Palette.Dark, tuned for white surfaces.
         Accent is darkened so the green still passes contrast on a light bg.  -->

    <SolidColorBrush x:Key="WindowBg" Color="#F4F4F5" />
    <SolidColorBrush x:Key="HeaderBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBgHover" Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBorder" Color="#E4E4E7" />
    <SolidColorBrush x:Key="CardBorderStrong" Color="#D4D4D8" />
    <SolidColorBrush x:Key="Divider" Color="#E4E4E7" />

    <SolidColorBrush x:Key="TextPrimary" Color="#18181B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#52525B" />
    <SolidColorBrush x:Key="TextTertiary" Color="#71717A" />
    <SolidColorBrush x:Key="TextDisabled" Color="#A1A1AA" />

    <SolidColorBrush x:Key="Accent" Color="#059669" />
    <SolidColorBrush x:Key="AccentHover" Color="#047857" />
    <SolidColorBrush x:Key="AccentPressed" Color="#065F46" />
    <SolidColorBrush x:Key="AccentGlow" Color="#1A059669" />

    <SolidColorBrush x:Key="TrackInactive" Color="#E4E4E7" />
    <SolidColorBrush x:Key="ThumbColor" Color="#18181B" />
    <SolidColorBrush x:Key="OverlayHover" Color="#0A000000" />
    <SolidColorBrush x:Key="OverlayPressed" Color="#14000000" />

    <SolidColorBrush x:Key="ButtonGhost" Color="#F4F4F5" />
    <SolidColorBrush x:Key="ButtonGhostHover" Color="#E4E4E7" />

    <SolidColorBrush x:Key="ErrorText" Color="#DC2626" />
    <SolidColorBrush x:Key="WarningAmber" Color="#D97706" />

</ResourceDictionary>
