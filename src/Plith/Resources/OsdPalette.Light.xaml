<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Stated once here and referenced below. It used to be typed out at each
         brush, which is not a shared value but the same value by coincidence — the kind that
         drifts the first time one of them is tuned. -->
    <Color x:Key="OsdSignalColor">#059669</Color>

    <!-- Light OSD overlay palette — paired key-for-key with OsdPalette.Dark.
         The surface stays slightly translucent so the underlying app/desktop still bleeds
         through; on top of bright content the OSD reads like a frosted card. Accent green
         is darkened so it passes contrast on a near-white surface. -->

    <!-- Surface alpha is higher than the dark variant (FA vs F0): light text needs a more
         opaque card so dark glyphs still read over an arbitrary underlying app. -->
    <LinearGradientBrush x:Key="OsdSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAE7E6E0" Offset="0" />
        <GradientStop Color="#FAF3F2ED" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OsdBorder" Color="#D0CEC6" />
    <SolidColorBrush x:Key="OsdHighlight" Color="#1A000000" />

    <SolidColorBrush x:Key="OsdTextPrimary" Color="#18181B" />
    <!-- Secondary/tertiary are darker than the Settings palette equivalents because the OSD
         surface is slightly translucent — anything lighter than #3F3F46 disappears over
         pale underlying content (white IDEs, browser pages). -->
    <SolidColorBrush x:Key="OsdTextSecondary" Color="#3F3F46" />
    <SolidColorBrush x:Key="OsdTextTertiary" Color="#52525B" />

    <SolidColorBrush x:Key="OsdTrackBg" Color="#22000000" />
    <SolidColorBrush x:Key="OsdAccent" Color="{StaticResource OsdSignalColor}" />
    <SolidColorBrush x:Key="OsdDivider" Color="#1A000000" />

    <!-- Volume bar threshold colours tuned for white surfaces — darker / saturated variants
         of the dark-theme equivalents so the bar still pops against the lighter card. -->
    <SolidColorBrush x:Key="OsdGainMuted" Color="#71717A" />
    <SolidColorBrush x:Key="OsdGainGreen" Color="{StaticResource OsdSignalColor}" />
    <SolidColorBrush x:Key="OsdGainAmber" Color="#CA8A04" />
    <SolidColorBrush x:Key="OsdGainRed" Color="#DC2626" />


    <!-- The notch's resting shape.

         Deliberately NOT OsdSurfaceBrush, which is what it used to be. A notch is a hole in the
         display, not a panel on it, and a hole is not lighter than the screen around it - on the
         light theme the card surface made the resting notch a pale bar sitting on a pale desktop,
         at which point it stops reading as a cutout and becomes a tab hanging off the top edge.

         Near-black in both themes, therefore, and that is the whole reason it is a separate
         token. -->
    <SolidColorBrush x:Key="NotchBezelBrush" Color="#06070A" />

    <!-- Ink for anything drawn on the notch: the widget pages and the event HUD.

         The Loft floor's Foreground, TextSecondary and Border for this theme. The notch paints
         on OsdSurfaceBrush, which is now the fixed floor and no longer moves with the accent, so
         these are constants rather than values computed per accent. The keys stay because about
         forty DynamicResource references consume them, and an unresolved one fails silently.
         OsdPalette.HighContrast.xaml keeps its own system-colour versions. -->
    <SolidColorBrush x:Key="NotchInk" Color="#161616" />
    <SolidColorBrush x:Key="NotchInkMuted" Color="#55544F" />
    <SolidColorBrush x:Key="NotchTrack" Color="#D0CEC6" />

    <!-- Loft's ornament layer, as tokens so a theme turns it off without touching a view.
         These override the OFF defaults in Ornaments.xaml, which App.xaml merges before this
         palette. 9 DIP is praxvon-ui's `ornament.corner`. The tick brush is the secondary-text
         ink for this floor: a ruler is quiet by design. -->
    <sys:Double x:Key="OrnamentCornerLength">9</sys:Double>
    <sys:Double x:Key="OrnamentOutlineThickness">1</sys:Double>
    <sys:String x:Key="OrnamentLabelCase">Upper</sys:String>
    <SolidColorBrush x:Key="OrnamentTickBrush" Color="#52525B" />
</ResourceDictionary>
