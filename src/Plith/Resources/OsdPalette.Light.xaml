<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light OSD overlay palette — paired key-for-key with OsdPalette.Dark.
         The surface stays slightly translucent so the underlying app/desktop still bleeds
         through; on top of bright content the OSD reads like a frosted card. Accent green
         is darkened so it passes contrast on a near-white surface. -->

    <!-- Surface alpha is higher than the dark variant (FA vs F0): light text needs a more
         opaque card so dark glyphs still read over an arbitrary underlying app. -->
    <LinearGradientBrush x:Key="OsdSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFAFAFA" Offset="0" />
        <GradientStop Color="#FAF0F0F0" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="OsdBorder" Color="#D4D4D8" />
    <SolidColorBrush x:Key="OsdHighlight" Color="#1A000000" />

    <SolidColorBrush x:Key="OsdTextPrimary" Color="#18181B" />
    <!-- Secondary/tertiary are darker than the Settings palette equivalents because the OSD
         surface is slightly translucent — anything lighter than #3F3F46 disappears over
         pale underlying content (white IDEs, browser pages). -->
    <SolidColorBrush x:Key="OsdTextSecondary" Color="#3F3F46" />
    <SolidColorBrush x:Key="OsdTextTertiary" Color="#52525B" />

    <SolidColorBrush x:Key="OsdTrackBg" Color="#22000000" />
    <SolidColorBrush x:Key="OsdAccent" Color="#059669" />
    <SolidColorBrush x:Key="OsdDivider" Color="#1A000000" />

    <!-- Volume bar threshold colours tuned for white surfaces — darker / saturated variants
         of the dark-theme equivalents so the bar still pops against the lighter card. -->
    <SolidColorBrush x:Key="OsdGainMuted" Color="#71717A" />
    <SolidColorBrush x:Key="OsdGainGreen" Color="#059669" />
    <SolidColorBrush x:Key="OsdGainAmber" Color="#CA8A04" />
    <SolidColorBrush x:Key="OsdGainRed" Color="#DC2626" />

</ResourceDictionary>
